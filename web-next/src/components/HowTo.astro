---
// How it works — cinematic alternating timeline.
// Three steps, each in a 2-column row that flips image side. A vertical
// hairline runs between rows. Step numeral is an oversized display serif
// stamp that sits in the gutter where the hairline meets each row.
//
// Step 01 swaps its photo for a native horizontal infographic
// (BookingFlowInfographic) so the booking flow gets a visual summary that
// fits the same 5:4 box as steps 02 and 03.
//
// Copy is kept aligned with the HowTo JSON-LD shipped from index.astro so
// the structured data and the on-page narrative agree.
import BookingFlowInfographic from '@/components/BookingFlowInfographic.astro';

const steps = [
  {
    n: '01',
    eyebrow: 'Step one · The message',
    title: 'Choose your experience.',
    body: 'Pick your date, number of guests, and any dietary needs. Choose from curated Moroccan menus — tagine, couscous, pastilla, or a full royal feast. Send it via WhatsApp or the form. Confirmation within 24 hours.',
    // step 01 swaps its photo for an inline native infographic; no image asset
    image: '',
    imageAlt: '',
    detail: 'Reply within an hour · 7 days a week',
    poster: true,
  },
  {
    n: '02',
    eyebrow: 'Step two · The morning',
    title: 'Your chef arrives.',
    body: 'Your personal chef shops the medina souk that morning for the freshest ingredients, then arrives at your villa with everything needed — spices, produce, cookware, tableware.',
    image: '/blue-tagine-moroccan-spices.webp',
    imageAlt: 'A blue ceramic tagine and Moroccan spices on a souk stall, photographed at first light',
    detail: 'Souk: 06:30 — 09:00 · Mise en place: 17:00',
  },
  {
    n: '03',
    eyebrow: 'Step three · The evening',
    title: 'Sit down and enjoy.',
    body: 'A multi-course Moroccan feast served course by course on your terrace. Appetizers, mains, dessert, traditional mint tea. After the meal, full kitchen, dish, and table cleanup is included.',
    image: '/moroccan-feast-villa-terrace.webp',
    imageAlt: 'A long villa terrace dinner table set for a Moroccan feast at dusk',
    detail: '4 to 6 courses · 2.5 to 3 hours · We leave the villa cleaner',
  },
];
---

<section id="how" class="bg-ink py-24 sm:py-32">
  <div data-reveal class="container">
    {/* Header */}
    <div class="mx-auto max-w-[820px] text-center">
      <span class="eyebrow inline-flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.32em] text-gold-light">
        <span aria-hidden="true" class="inline-block size-1.5 rotate-45 bg-ember"></span>
        05 · How it works
      </span>
      <h2 class="mt-6 font-display text-[clamp(2.25rem,4.5vw,3.75rem)] leading-[1] tracking-[0.04em] text-sand">
        From WhatsApp to
        <em class="font-serif italic font-normal text-gold-light">first course</em>,
        in three steps.
      </h2>
    </div>

    {/* Timeline — vertical hairline running through the middle, alternating rows */}
    <ol class="relative mx-auto mt-20 max-w-[1100px]">
      <span
        aria-hidden="true"
        class="pointer-events-none absolute start-4 top-0 bottom-0 w-px bg-gradient-to-b from-transparent via-gold/30 to-transparent md:start-1/2 md:-translate-x-1/2"
      ></span>

      {steps.map((s, i) => {
        const flipped = i % 2 === 1;
        return (
          <li class="relative grid grid-cols-1 items-center gap-8 ps-12 md:grid-cols-12 md:gap-12 md:ps-0 mb-20 last:mb-0">
            {/* Number stamp — sits on the hairline */}
            <span
              aria-hidden="true"
              class="absolute start-0 top-0 z-10 -translate-x-1/2 bg-ink px-2 font-display text-[clamp(2.25rem,4vw,3.25rem)] leading-none tracking-[0.05em] text-ember md:start-1/2"
            >
              {s.n}
            </span>

            {/* Image — posters get a portrait box and skip the colour overlay */}
            <figure
              class={[
                'relative overflow-hidden border border-gold/15 bg-ink-light',
                'md:col-span-5',
                flipped ? 'md:col-start-8' : 'md:col-start-1',
              ].join(' ')}
            >
              {s.poster ? (
                <BookingFlowInfographic />
              ) : (
                <>
                  <div class="aspect-[5/4]">
                    <img
                      src={s.image}
                      alt={s.imageAlt}
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover transition duration-[1200ms] ease-out hover:scale-[1.03]"
                    />
                  </div>
                  <div class="absolute inset-0 bg-ember/15 mix-blend-multiply" aria-hidden="true"></div>
                  <div class="absolute inset-0 bg-gradient-to-t from-ink/45 via-transparent to-transparent" aria-hidden="true"></div>
                </>
              )}
            </figure>

            {/* Text */}
            <div
              class={[
                'md:col-span-6',
                flipped ? 'md:col-start-1 md:row-start-1 md:pe-8 md:text-end' : 'md:col-start-7 md:ps-8',
              ].join(' ')}
            >
              <span class="font-mono text-[10px] uppercase tracking-[0.28em] text-gold-light">
                {s.eyebrow}
              </span>
              <h3 class="mt-3 font-display text-[clamp(1.6rem,2.6vw,2.4rem)] leading-[1.05] tracking-[0.02em] text-sand">
                {s.title}
              </h3>
              <p class={['mt-4 max-w-[52ch] text-[15px] leading-[1.7] text-sand-muted', flipped ? 'md:ms-auto' : ''].join(' ')}>
                {s.body}
              </p>
              <p class={['mt-5 font-mono text-[10px] uppercase tracking-[0.22em] text-gold-light', flipped ? 'md:ms-auto' : ''].join(' ')}>
                {s.detail}
              </p>
            </div>
          </li>
        );
      })}
    </ol>

    {/* Closing CTA — same primary pill */}
    <div class="mt-6 text-center">
      <a
        href="#booking"
        class="group inline-flex items-center gap-3 rounded-full bg-ember px-9 py-4 font-mono text-[12px] uppercase tracking-[0.22em] text-white shadow-[0_18px_40px_-12px_rgba(184,79,46,0.55)] transition hover:-translate-y-px hover:bg-ember-light"
      >
        Book your dinner
        <span aria-hidden="true" class="inline-block size-2 rotate-45 bg-white transition group-hover:translate-x-0.5"></span>
      </a>
    </div>
  </div>
</section>
