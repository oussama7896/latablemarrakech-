---
// Testimonials — "The guests." Hero quote at film-poster scale carries the
// whole emotional load; two supporting cards below run quieter. The hero
// quote pulls one dish out of the testimonial copy as a clickable chip
// linking to its course in the FeaturedMenu — turns social proof into a
// menu cross-sell.
import defaultQuotes from '@/data/home-testimonials.json';

type Quote = { author: string; context: string; quote: string };

interface Props {
  eyebrow?: string;
  rating?: string;
  ratingLabel?: string;
  headlineHead?: string;
  headlineEm?: string;
  sub?: string;
  readAll?: string;
  /** Override the auto-picked hero dish chip + link target. */
  heroDish?: { label: string; href: string };
  quotes?: Quote[];
}

const {
  eyebrow = '03 · The guests',
  rating = '4.9',
  ratingLabel = '4.9 / 5 from 200+ guests',
  headlineHead = '4.9 / 5 from',
  headlineEm = '200+ guests',
  sub = 'Real reviews. Real villas. Real Friday-night couscous.',
  readAll = 'Read all reviews',
  heroDish = { label: 'Tasted the pastilla', href: '#menu' },
  quotes = defaultQuotes as Quote[],
} = Astro.props as Props;

const cards: Quote[] = quotes.slice(0, 3);
const hero = cards[0];
const supporting = cards.slice(1);
---

<section id="testimonials" class="bg-ink py-20 sm:py-24" data-frame="03|The guests">
  <div data-reveal class="container max-w-[1180px]">
    {/* ---------- Header ---------- */}
    <div class="mx-auto max-w-[820px] text-center">
      <span class="eyebrow inline-flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.32em] text-gold-light">
        <span aria-hidden="true" class="inline-block size-1.5 rotate-45 bg-ember"></span>
        {eyebrow}
      </span>
      <h2 class="mt-6 font-display text-[clamp(2.25rem,4.5vw,3.75rem)] leading-[1] tracking-[0.04em] text-sand">
        {headlineHead}
        <em class="font-serif italic font-normal text-gold-light"> {headlineEm}</em>
      </h2>
      <p class="mx-auto mt-5 max-w-[520px] text-[15px] leading-[1.7] text-sand-muted">
        {sub}
      </p>
    </div>

    {/* ---------- Hero quote ---------- */}
    <figure
      class="relative mx-auto mt-16 max-w-[960px] border border-gold/20 bg-ink-light px-8 py-12 sm:px-14 sm:py-16 lg:px-20 lg:py-20"
    >
      {/* Soft ember glow above, like a single key-light */}
      <span
        aria-hidden="true"
        class="pointer-events-none absolute -top-32 left-1/2 h-[280px] w-[520px] -translate-x-1/2 rounded-full bg-ember/10 blur-3xl"
      ></span>

      {/* Corner marks — same vocabulary as the FeaturedMenu carte */}
      <span aria-hidden="true" class="pointer-events-none absolute -top-1 -start-1 hidden size-3 border-t border-s border-ember sm:block"></span>
      <span aria-hidden="true" class="pointer-events-none absolute -top-1 -end-1 hidden size-3 border-t border-e border-ember sm:block"></span>
      <span aria-hidden="true" class="pointer-events-none absolute -bottom-1 -start-1 hidden size-3 border-b border-s border-ember sm:block"></span>
      <span aria-hidden="true" class="pointer-events-none absolute -bottom-1 -end-1 hidden size-3 border-b border-e border-ember sm:block"></span>

      <span aria-hidden="true" class="block font-display text-[clamp(4rem,8vw,7rem)] leading-[0.6] text-ember/70">
        &ldquo;
      </span>

      <blockquote class="mt-2 font-serif italic font-normal text-[clamp(1.6rem,3vw,2.6rem)] leading-[1.32] text-gold-light">
        {hero.quote}
      </blockquote>

      <figcaption class="mt-10 flex flex-wrap items-center justify-between gap-4 border-t border-gold/15 pt-6">
        <div class="flex flex-col gap-1">
          <span class="font-mono text-[11px] uppercase tracking-[0.26em] text-sand">— {hero.author}</span>
          <span class="font-mono text-[10px] uppercase tracking-[0.24em] text-sand-muted">{hero.context}</span>
        </div>

        <a
          href={heroDish.href}
          class="group inline-flex items-center gap-2 rounded-full border border-gold/25 bg-ink/40 px-4 py-1.5 font-mono text-[10px] uppercase tracking-[0.22em] text-gold-light transition hover:border-ember hover:bg-ember/10 hover:text-sand"
        >
          <span aria-hidden="true" class="inline-block size-1 rotate-45 bg-ember"></span>
          {heroDish.label}
        </a>
      </figcaption>
    </figure>

    {/* ---------- Supporting row ---------- */}
    <div class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-2 md:gap-6">
      {supporting.map((q) => (
        <figure class="group flex flex-col gap-5 border border-gold/15 bg-ink-light p-7 transition hover:border-ember/50 sm:p-8">
          <span class="inline-flex w-fit items-center gap-2 rounded-full border border-gold/25 bg-ink/40 px-3 py-1 font-mono text-[10px] uppercase tracking-[0.22em] text-gold-light">
            ★★★★★ <span class="text-sand/80">verified</span>
          </span>
          <span aria-hidden="true" class="font-display text-[44px] leading-[0.5] text-ember/80">&ldquo;</span>
          <blockquote class="font-serif text-[16px] italic leading-[1.55] text-sand">
            {q.quote}
          </blockquote>
          <figcaption class="mt-auto border-t border-gold/15 pt-4 font-mono text-[11px] uppercase tracking-[0.22em]">
            <span class="block text-sand">— {q.author}</span>
            <span class="mt-1 block text-sand-muted">{q.context}</span>
          </figcaption>
        </figure>
      ))}
    </div>

    {/* ---------- Aggregate bar ---------- */}
    <div class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-gold/15 pt-8 sm:flex-row">
      <div class="flex items-center gap-5">
        <span class="font-display text-[clamp(1.65rem,2.2vw,2.1rem)] leading-none text-sand">{rating}</span>
        <span class="text-[15px] tracking-wider text-ember">★★★★★</span>
        <span class="font-mono text-[10px] uppercase tracking-[0.22em] text-sand-muted">
          {ratingLabel}
        </span>
      </div>
      <a
        href="https://www.google.com/search?q=La+Table+Marrakech+reviews"
        target="_blank"
        rel="noopener"
        class="group inline-flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.24em] text-gold-light transition hover:text-sand"
      >
        {readAll}
        <span
          aria-hidden="true"
          class="inline-block h-px w-10 bg-gold/60 transition group-hover:w-16 group-hover:bg-ember"
        ></span>
      </a>
    </div>
  </div>
</section>
