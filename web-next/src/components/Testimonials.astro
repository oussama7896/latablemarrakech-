---
// Testimonials — three equal-weight quote cards on a single row.
// No imagery — the typography and a small ember rating diamond do the work.
// A quiet aggregate-rating bar sits under the row.
import quotes from '@/data/home-testimonials.json';

type Quote = { quote: string; author: string; context: string };
const cards: Quote[] = (quotes as Quote[]).slice(0, 3);
---

<section id="testimonials" class="bg-ink py-16 sm:py-20">
  <div data-reveal class="container">
    {/* Header */}
    <div class="mx-auto max-w-[760px] text-center">
      <span class="eyebrow inline-flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.32em] text-gold-light">
        <span aria-hidden="true" class="inline-block size-1.5 rotate-45 bg-ember"></span>
        03 · The guests
      </span>
      <h2 class="mt-6 font-display text-[clamp(2.25rem,4.5vw,3.75rem)] leading-[1] tracking-[0.04em] text-sand">
        4.9 / 5 from
        <em class="font-serif italic font-normal text-gold-light">200+ guests</em>
      </h2>
      <p class="mx-auto mt-5 max-w-[520px] text-[15px] leading-[1.7] text-sand-muted">
        Real reviews. Real villas. Real Friday-night couscous.
      </p>
    </div>

    {/* Three equal review cards on one row */}
    <div class="mt-16 grid grid-cols-1 gap-5 md:grid-cols-3 md:gap-6">
      {cards.map((q) => (
        <figure class="group flex flex-col gap-5 border border-gold/15 bg-ink-light p-7 transition hover:border-ember/50 sm:p-8">
          <span class="inline-flex w-fit items-center gap-2 rounded-full border border-gold/25 bg-ink/40 px-3 py-1 font-mono text-[10px] uppercase tracking-[0.22em] text-gold-light">
            ★★★★★ <span class="text-sand/80">verified</span>
          </span>
          <span aria-hidden="true" class="font-display text-[56px] leading-[0.5] text-ember/80">&ldquo;</span>
          <blockquote class="font-serif text-[16.5px] italic leading-[1.6] text-sand">
            {q.quote}
          </blockquote>
          <figcaption class="mt-auto border-t border-gold/15 pt-4 font-mono text-[11px] uppercase tracking-[0.22em]">
            <span class="block text-sand">— {q.author}</span>
            <span class="mt-1 block text-sand-muted">{q.context}</span>
          </figcaption>
        </figure>
      ))}
    </div>

    {/* Quiet aggregate bar — full-width, low contrast */}
    <div class="mt-8 flex flex-col items-center justify-between gap-4 border-t border-gold/15 pt-8 sm:flex-row">
      <div class="flex items-center gap-5">
        <span class="font-display text-[clamp(1.65rem,2.2vw,2.1rem)] leading-none text-sand">4.9</span>
        <span class="text-[15px] tracking-wider text-ember">★★★★★</span>
        <span class="font-mono text-[10px] uppercase tracking-[0.22em] text-sand-muted">
          200+ villa guests reviewed
        </span>
      </div>
      <a
        href="https://www.google.com/search?q=La+Table+Marrakech+reviews"
        target="_blank"
        rel="noopener"
        class="group inline-flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.24em] text-gold-light transition hover:text-sand"
      >
        Read all reviews
        <span
          aria-hidden="true"
          class="inline-block h-px w-10 bg-gold/60 transition group-hover:w-16 group-hover:bg-ember"
        ></span>
      </a>
    </div>

  </div>
</section>
