---
// Visual Story — editorial asymmetric gallery. Pure CSS for layout; Astro
// renders static markup, no React island needed. Parallax is opt-in via a
// scoped IntersectionObserver script so we don't pull framer-motion just to
// translate a few images by a few px.

const tiles = [
  {
    src: '/Lamb-Tagine-with-Onions-Raisins-560x300.jpg.webp',
    alt: 'Lamb tagine, slow-cooked with sweet onions and raisins',
    caption: 'Slow-cooked, never rushed.',
    span: 'col-span-12 md:col-span-7 row-span-2 aspect-[4/5] md:aspect-[5/6]',
    depth: '0.25',
  },
  {
    src: '/El-Oualidia-Oysters-with-Red-Wine-Vinegar-560x300.png.webp',
    alt: 'El Oualidia oysters served with red wine mignonette',
    caption: 'From the Atlantic, that morning.',
    span: 'col-span-12 md:col-span-5 aspect-[4/3]',
    depth: '0.4',
  },
  {
    src: '/Smoked-Salmon-on-Blinis-with-Lemon-Cream-Sauce-560x300.jpg.webp',
    alt: 'Smoked salmon on blinis with lemon cream',
    caption: 'A first course that sets the room quiet.',
    span: 'col-span-6 md:col-span-3 aspect-square',
    depth: '0.18',
  },
  {
    src: '/sahara-nights-royal-couscous-560x300.jpg.webp',
    alt: 'Sahara nights royal couscous platter',
    caption: 'Friday night, the way it should be.',
    span: 'col-span-6 md:col-span-2 aspect-[4/5]',
    depth: '0.35',
  },
  {
    src: '/blue-tagine-moroccan-spices.webp',
    alt: 'Blue ceramic tagine and Moroccan spices on a market stall',
    caption: 'Souk, six in the morning.',
    span: 'col-span-12 md:col-span-8 aspect-[16/9] md:aspect-[16/7]',
    depth: '0.22',
  },
  {
    src: '/Beef-Tagine-with-Prunes-Almonds-560x300.jpg.webp',
    alt: 'Beef tagine with prunes and toasted almonds',
    caption: 'Beef, prunes, time.',
    span: 'col-span-12 md:col-span-4 aspect-[3/4] md:aspect-[3/4]',
    depth: '0.3',
  },
];
---

<section id="story" class="bg-ink-light py-24 sm:py-28">
  <div class="container">
    {/* Header is offset to the left for editorial rhythm */}
    <div data-reveal class="mb-14 grid grid-cols-12 gap-6 sm:mb-20">
      <div class="col-span-12 md:col-span-7 lg:col-span-6">
        <span class="eyebrow inline-flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.32em] text-gold-light">
          <span aria-hidden="true" class="inline-block size-1.5 rotate-45 bg-ember"></span>
          06 · Through the lens
        </span>
        <h2 class="mt-6 font-display text-[clamp(2.25rem,4.5vw,3.75rem)] leading-[1] tracking-[0.04em] text-sand">
          Quiet moments, <em class="font-serif italic font-normal text-gold-light">made slowly</em>.
        </h2>
      </div>
      <div class="col-span-12 md:col-span-5 md:col-start-8 lg:col-span-4 lg:col-start-9 md:self-end">
        <p class="text-[15px] leading-[1.75] text-sand-muted">
          A walk through the souk before the city wakes. A clay tagine on a low flame for
          three hours. A first course brought to the table while the light is still gold.
        </p>
      </div>
    </div>

    {/* 12-col asymmetric gallery */}
    <div data-gallery class="grid grid-cols-12 gap-3 sm:gap-4">
      {tiles.map((tile) => (
        <figure
          class={`lt-tile group relative isolate overflow-hidden ${tile.span}`}
          data-parallax-depth={tile.depth}
        >
          <img
            src={tile.src}
            alt={tile.alt}
            loading="lazy"
            decoding="async"
            class="lt-tile-img absolute inset-0 h-[112%] w-full object-cover will-change-transform transition duration-[1200ms] ease-out group-hover:scale-[1.03]"
          />
          {/* Texture + readability */}
          <div class="absolute inset-0 bg-ember/10 mix-blend-multiply" aria-hidden="true"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-ink/70 via-ink/0 to-transparent" aria-hidden="true"></div>

          <figcaption class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 p-5 sm:p-6">
            <span class="font-serif italic text-[15px] leading-[1.3] text-sand">
              {tile.caption}
            </span>
            <span
              aria-hidden="true"
              class="inline-block h-px w-8 origin-right scale-x-50 bg-gold/70 transition duration-500 group-hover:scale-x-100 group-hover:bg-ember"
            ></span>
          </figcaption>
        </figure>
      ))}
    </div>

    {/* Quiet sign-off */}
    <p data-reveal class="mt-16 max-w-[460px] font-serif italic text-[17px] leading-[1.7] text-gold-light">
      “Cooking is patience that tastes like care.”
      <span class="mt-3 block font-mono text-[10px] not-italic uppercase tracking-[0.28em] text-sand-muted">
        — Chef · La Table Marrakech
      </span>
    </p>
  </div>
</section>

<script>
  // Lightweight scroll-linked parallax. transform only, opacity only — no
  // jank, no transition-all. Respects prefers-reduced-motion.
  type ParallaxItem = { el: HTMLImageElement; depth: number; rect: () => DOMRect };

  function initParallax() {
    if (typeof window === 'undefined') return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const gallery = document.querySelector<HTMLElement>('[data-gallery]');
    if (!gallery) return;

    const items: ParallaxItem[] = Array.from(
      gallery.querySelectorAll<HTMLElement>('[data-parallax-depth]'),
    ).map((tile) => {
      const img = tile.querySelector<HTMLImageElement>('.lt-tile-img')!;
      const depth = Number(tile.dataset.parallaxDepth ?? '0.2');
      return { el: img, depth, rect: () => tile.getBoundingClientRect() };
    });
    if (!items.length) return;

    let ticking = false;
    const update = () => {
      const vh = window.innerHeight;
      for (const item of items) {
        const r = item.rect();
        if (r.bottom < 0 || r.top > vh) continue;
        // -1 (just entered from bottom) → +1 (about to leave at top)
        const progress = (r.top + r.height / 2 - vh / 2) / vh;
        const shift = progress * item.depth * 60; // px
        item.el.style.transform = `translate3d(0, ${(-shift).toFixed(2)}px, 0)`;
      }
      ticking = false;
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initParallax, { once: true });
  } else {
    initParallax();
  }
</script>
