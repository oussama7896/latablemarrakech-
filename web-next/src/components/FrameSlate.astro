---
// Frame Slate — a persistent cinematic film-slate that follows the page.
// On desktop (≥1024px) it sits as a fixed vertical strip on the inline-end
// edge of the viewport. It shows the current scene number, the eyebrow, and
// a thin scroll-progress hairline. On mobile it collapses into a thin
// progress ribbon below the nav. The slate connects every numbered section
// into one cinematic sequence — the system's connective tissue at scale.
//
// Sections register themselves with the slate via `data-frame="NN|Label"`
// attributes on the wrapping <section>. The slate then picks the active
// frame as the page scrolls, and updates the progress bar by the page's
// total scroll percentage. RTL-aware: the strip auto-flips to the left edge
// when the document is `dir="rtl"`.
//
// Pure progressive-enhancement: zero JS, the page still works. The slate is
// inert (pointer-events: none) and aria-hidden so screen readers don't read
// the running count. prefers-reduced-motion disables the smooth tween on
// the active-frame transition.
//
// Pass `lang` to localize the two label strings — "Now showing" / "End".
const lang = (Astro.props.lang ?? 'en') as 'en' | 'fr' | 'ar';
const labels = {
  en: { now: 'Now showing', end: 'End of reel' },
  fr: { now: 'À l’écran', end: 'Fin de la séance' },
  ar: { now: 'يُعرض الآن', end: 'نهاية البوبينة' },
}[lang];
---

<aside class="lt-slate" data-slate aria-hidden="true">
  {/* Desktop: vertical rail on the inline-end edge */}
  <div class="lt-slate-rail">
    <span class="lt-slate-now">{labels.now}</span>
    <span class="lt-slate-num" data-slate-num>—</span>
    <span class="lt-slate-eyebrow" data-slate-label>{labels.end}</span>
    <span class="lt-slate-bar">
      <span class="lt-slate-fill" data-slate-fill></span>
    </span>
  </div>

  {/* Mobile: thin progress ribbon under the nav */}
  <span class="lt-slate-ribbon" data-slate-ribbon></span>
</aside>

<script>
  // Pick up all sections that opted into the slate by setting `data-frame`,
  // then track which one is currently most visible. Single rAF-throttled
  // scroll listener keeps the slate cheap; one IntersectionObserver covers
  // the active-frame detection. The fill bar maps page-scroll percentage
  // to the rail's vertical fill.
  (function () {
    const root = document.querySelector<HTMLElement>('[data-slate]');
    if (!root) return;

    const frames = Array.from(document.querySelectorAll<HTMLElement>('[data-frame]'));
    if (!frames.length) {
      root.setAttribute('hidden', '');
      return;
    }

    const numEl = root.querySelector<HTMLElement>('[data-slate-num]');
    const labelEl = root.querySelector<HTMLElement>('[data-slate-label]');
    const fillEl = root.querySelector<HTMLElement>('[data-slate-fill]');
    const ribbonEl = root.querySelector<HTMLElement>('[data-slate-ribbon]');

    // Track the most-prominent frame currently in view. The IO threshold list
    // lets us pick the one with the highest intersectionRatio at any moment.
    let active: HTMLElement | null = null;
    const setActive = (el: HTMLElement | null) => {
      if (active === el) return;
      active = el;
      if (!el) {
        if (numEl) numEl.textContent = '—';
        if (labelEl) labelEl.textContent = '';
        root.dataset.state = 'idle';
        return;
      }
      const raw = el.getAttribute('data-frame') || '';
      const [num, label] = raw.split('|').map((s) => s.trim());
      if (numEl) numEl.textContent = num || '—';
      if (labelEl) labelEl.textContent = label || '';
      root.dataset.state = 'active';
    };

    // Pick the frame whose center is closest to the viewport center. This is
    // more robust than IntersectionObserver alone when frames overlap.
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        const vhCenter = window.innerHeight / 2;
        let best: { el: HTMLElement; d: number } | null = null;
        for (const el of frames) {
          const rect = el.getBoundingClientRect();
          if (rect.bottom < 0 || rect.top > window.innerHeight) continue;
          const center = rect.top + rect.height / 2;
          const d = Math.abs(center - vhCenter);
          if (!best || d < best.d) best = { el, d };
        }
        setActive(best ? best.el : null);

        // Scroll-progress fill
        const doc = document.documentElement;
        const max = Math.max(doc.scrollHeight, document.body.scrollHeight) - window.innerHeight;
        const pct = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
        if (fillEl) fillEl.style.transform = `scaleY(${pct.toFixed(4)})`;
        if (ribbonEl) ribbonEl.style.transform = `scaleX(${pct.toFixed(4)})`;
      });
    };

    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  })();
</script>

<style>
  /* Visually hidden on screens too narrow to host the rail; the ribbon does
     the work on those viewports. */
  .lt-slate {
    position: fixed;
    inset: var(--lt-nav-h, 76px) 0 0 auto;
    width: 64px;
    pointer-events: none;
    z-index: 60;
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
  }
  [dir="rtl"] .lt-slate { inset: var(--lt-nav-h, 76px) auto 0 0; justify-content: flex-start; }

  .lt-slate-rail {
    position: sticky;
    top: calc(var(--lt-nav-h, 76px) + 48px);
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 18px 0;
    margin-inline-end: 18px;
    color: var(--gold-light);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity .8s cubic-bezier(.16,1,.3,1), transform .8s cubic-bezier(.16,1,.3,1);
    will-change: opacity, transform;
  }
  [dir="rtl"] .lt-slate-rail { margin-inline-end: 0; margin-inline-start: 18px; }

  .lt-slate[data-state="active"] .lt-slate-rail { opacity: 1; transform: none; }

  .lt-slate-now,
  .lt-slate-eyebrow {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--sand-muted);
    white-space: nowrap;
    line-height: 1;
    transition: color .4s ease;
  }
  .lt-slate-eyebrow { color: var(--gold-light); max-height: 220px; overflow: hidden; }
  [dir="rtl"] .lt-slate-now,
  [dir="rtl"] .lt-slate-eyebrow {
    writing-mode: vertical-lr;
    transform: none;
  }

  .lt-slate-num {
    font-family: var(--font-display);
    font-size: 22px;
    letter-spacing: 0.06em;
    color: var(--ember);
    line-height: 1;
    padding: 4px 0;
  }

  .lt-slate-bar {
    position: relative;
    width: 1px;
    height: 120px;
    background: rgba(184, 147, 90, 0.18);
    margin-top: 4px;
  }
  .lt-slate-fill {
    position: absolute; inset: 0 0 auto 0;
    height: 100%;
    background: linear-gradient(to bottom, var(--ember) 0%, var(--gold-light) 60%, transparent 100%);
    transform-origin: top;
    transform: scaleY(0);
    will-change: transform;
    transition: transform .12s linear;
  }

  /* Mobile ribbon — replaces the rail on narrow viewports */
  .lt-slate-ribbon {
    display: block;
    position: fixed;
    top: var(--lt-nav-h, 76px);
    left: 0;
    height: 2px;
    width: 100%;
    background: linear-gradient(to right, var(--ember), var(--gold-light) 70%, transparent);
    transform-origin: left;
    transform: scaleX(0);
    will-change: transform;
    transition: transform .12s linear;
    z-index: 60;
    opacity: 0.85;
  }
  [dir="rtl"] .lt-slate-ribbon { transform-origin: right; }

  /* Desktop rail kicks in at lg breakpoint */
  @media (min-width: 1024px) {
    .lt-slate-rail { display: flex; }
    .lt-slate-ribbon { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .lt-slate-rail,
    .lt-slate-fill,
    .lt-slate-ribbon { transition: none; }
  }
</style>
