---
// MobileStickyCta — fixed bottom bar, mobile only.
// Solves the Casey persona thumb-zone issue: on phones the Hero CTA falls
// mid-viewport and the nav CTA sits top-right (out of one-handed reach).
// This bar keeps the canonical "Book your dinner" and a WhatsApp icon
// always in the thumb zone. Hidden ≥ 900px.
---

<div class="lt-mob-cta" aria-label="Quick book">
  <a
    href="#booking"
    data-event="booking_link_click"
    data-location="mobile-sticky"
    class="lt-mob-cta__primary"
  >
    Book your dinner
    <span aria-hidden="true" class="lt-mob-cta__diamond"></span>
  </a>
  <a
    href="https://wa.me/212721354757"
    target="_blank"
    rel="noopener noreferrer"
    data-event="whatsapp_click"
    data-location="mobile-sticky"
    aria-label="WhatsApp"
    class="lt-mob-cta__wa"
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
  </a>
</div>

<style>
  .lt-mob-cta {
    position: fixed;
    inset-inline: 12px;
    bottom: calc(env(safe-area-inset-bottom, 0px) + 12px);
    z-index: 90; /* below nav (100), above content */
    display: flex;
    gap: 8px;
    align-items: stretch;
  }
  .lt-mob-cta__primary {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 22px;
    background: var(--ember);
    color: var(--sand);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: 0 14px 36px -10px rgba(180, 90, 40, 0.65), 0 2px 8px rgba(8, 6, 4, 0.5);
    transition: background-color .25s ease-out, transform .2s ease-out;
  }
  .lt-mob-cta__primary:active { transform: translateY(1px); }
  .lt-mob-cta__diamond {
    display: inline-block;
    width: 7px; height: 7px;
    background: var(--sand);
    transform: rotate(45deg);
  }
  .lt-mob-cta__wa {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px; height: 52px;
    flex-shrink: 0;
    background: #25D366;
    color: #FFFFFF;
    border-radius: 999px;
    box-shadow: 0 14px 36px -10px rgba(37, 211, 102, 0.55), 0 2px 8px rgba(8, 6, 4, 0.5);
    text-decoration: none;
    transition: transform .2s ease-out;
  }
  .lt-mob-cta__wa:active { transform: translateY(1px); }

  /* Desktop hide */
  @media (min-width: 900px) {
    .lt-mob-cta { display: none; }
  }

  /* Hide while WhatsApp success card is showing — the page is already in
     a confirmation state, double CTA would be noise. */
  :global(body:has([role="status"][aria-live="polite"])) .lt-mob-cta {
    display: none;
  }
</style>
