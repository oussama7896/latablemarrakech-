---
const lang = (Astro.props.lang ?? 'en') as 'en' | 'fr' | 'ar';
const labels = {
  en: { exp: 'THE EXPERIENCE', how: 'HOW IT WORKS', faq: 'FAQ', book: 'BOOK NOW' },
  fr: { exp: "L'EXPÉRIENCE", how: 'COMMENT ÇA MARCHE', faq: 'FAQ', book: 'RÉSERVER' },
  ar: { exp: 'التجربة', how: 'كيف نعمل', faq: 'الأسئلة', book: 'احجز الآن' },
}[lang];
---

<header class="nav">
  <div class="container nav_block">
    <a href="#hero" class="nav-logo">
      <div class="diamond-outline" aria-hidden="true"></div>
      <span class="nav-logo-text">LA TABLE</span>
      <span class="nav-logo-divider" aria-hidden="true"></span>
      <span class="nav-logo-sub">Marrakech</span>
    </a>
    <nav class="nav-links" aria-label="Primary">
      <a href="#about">{labels.exp}</a>
      <a href="#how">{labels.how}</a>
      <a href="#faqs">{labels.faq}</a>
      <a
        data-event="whatsapp_click"
        data-location="home"
        href="https://wa.me/212721354757"
        target="_blank"
        rel="noopener noreferrer"
        class="nav-whatsapp"
        title="WhatsApp us"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span>+212 721 354 757</span>
      </a>
      <a href="#booking" class="nav-cta">{labels.book}</a>
      <div class="lang-switcher">
        <a href="/" class={lang === 'en' ? 'lang-btn active' : 'lang-btn'}>EN</a>
        <a href="/fr/" class={lang === 'fr' ? 'lang-btn active' : 'lang-btn'}>FR</a>
        <a href="/ar/" class={lang === 'ar' ? 'lang-btn active' : 'lang-btn'}>عربي</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .nav { background: rgba(8,6,4,0.95); border-bottom: 1px solid rgba(184,147,90,0.1); position: sticky; top: 0; z-index: 100; backdrop-filter: blur(12px); }
  .nav_block { display: flex; gap: 1rem; justify-content: space-between; align-items: center; height: 80px; }
  .nav-logo { display: flex; align-items: center; gap: 14px; text-decoration: none; }
  .diamond-outline { width: 11px; height: 11px; border: 1.5px solid var(--ember); transform: rotate(45deg); position: relative; display: inline-block; }
  .diamond-outline::after { content: ''; position: absolute; inset: 2px; background: var(--ember); }
  .nav-logo-text { font-family: var(--font-display); font-size: 24px; letter-spacing: 3px; color: var(--sand); line-height: 1; }
  .nav-logo-divider { width: 1px; height: 24px; background: var(--gold); opacity: 0.3; }
  .nav-logo-sub { font-family: var(--font-serif); font-style: italic; font-size: 13px; color: var(--gold-light); letter-spacing: 1px; }
  .nav-links { display: flex; align-items: center; gap: 32px; }
  .nav-links a { font-family: var(--font-mono); font-size: 11px; letter-spacing: 2.5px; text-transform: uppercase; color: var(--sand-muted); text-decoration: none; transition: color .3s; }
  .nav-links a:hover { color: var(--sand); }
  .nav-whatsapp { display: inline-flex !important; align-items: center; gap: 6px; color: #25D366 !important; }
  .nav-cta { background: var(--ember); color: #fff !important; padding: 10px 24px; transition: background .3s; }
  .nav-cta:hover { background: var(--ember-light); }
  .lang-switcher { display: flex; align-items: center; gap: 4px; margin-left: 8px; }
  .lang-btn { padding: 5px 10px; font-family: var(--font-mono); font-size: 10px; letter-spacing: 1px; border: 1px solid rgba(184,147,90,0.2); color: var(--sand-muted); text-decoration: none; }
  .lang-btn.active { background: var(--ember); color: #fff; border-color: var(--ember); }
  @media (max-width: 768px) { .nav-links { display: none; } }
</style>
