---
// Hero — Hyperagent layout DNA, content-first, no images.
// Centered display headline, narrow measure, single CTA, generous padding.
// Three quiet trust facts replace the photo as the supporting evidence.
---

<section id="hero" class="bg-ink pb-20 pt-28 sm:pt-36 sm:pb-28">
  <div class="lt-hero-enter container flex flex-col items-center gap-10 text-center">
    <span class="inline-flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.32em] text-gold-light">
      <span aria-hidden="true" class="inline-block size-1.5 rotate-45 bg-ember"></span>
      Private Chef Service · Marrakech
    </span>

    <h1 class="max-w-[860px] font-display text-[clamp(3rem,9vw,7rem)] font-normal leading-[0.9] tracking-[0.02em] text-sand">
      Your villa. Your table.
      <em class="mt-3 block font-serif italic font-normal text-[0.45em] tracking-[0.01em] text-gold-light">
        — your chef, at your riad tonight.
      </em>
    </h1>

    <p class="max-w-[640px] text-[17px] leading-[1.7] text-sand">
      A multi-course Moroccan dinner brought to your villa or riad. Souk-fresh that morning,
      cooked in your kitchen, served on your terrace.
    </p>

    <div class="flex flex-col items-center gap-4 pt-2">
      <a
        href="#booking"
        class="group inline-flex items-center gap-3 rounded-full bg-ember px-8 py-4 font-mono text-[12px] uppercase tracking-[0.22em] text-white transition hover:-translate-y-px hover:bg-ember-light"
      >
        Reserve your table
        <span aria-hidden="true" class="inline-block size-2 rotate-45 bg-white transition group-hover:translate-x-0.5"></span>
      </a>
      <span class="font-mono text-[11px] uppercase tracking-[0.22em] text-sand-muted">
        From €85 / person · Confirmed in 24h via WhatsApp
      </span>
    </div>

    {/* Three quiet trust facts — replace the photo as proof. Tightly typeset,
        evenly spaced, no card chrome. Pure data restraint. */}
    <dl class="mt-12 grid w-full max-w-[820px] grid-cols-3 gap-4 border-t border-gold/15 pt-10 sm:gap-8">
      <div class="flex flex-col items-center gap-1.5">
        <dt class="font-mono text-[10px] uppercase tracking-[0.22em] text-sand-muted">Rating</dt>
        <dd class="font-display text-[clamp(1.5rem,3vw,2.25rem)] tracking-[0.04em] text-sand">★ 4.9 / 5</dd>
        <dd class="font-mono text-[10px] tracking-[0.18em] text-gold-light">200+ villa guests</dd>
      </div>
      <div class="flex flex-col items-center gap-1.5 border-x border-gold/15 px-4">
        <dt class="font-mono text-[10px] uppercase tracking-[0.22em] text-sand-muted">All-in</dt>
        <dd class="font-display text-[clamp(1.5rem,3vw,2.25rem)] tracking-[0.04em] text-sand">€85 / pp</dd>
        <dd class="font-mono text-[10px] tracking-[0.18em] text-gold-light">No hidden fees</dd>
      </div>
      <div class="flex flex-col items-center gap-1.5">
        <dt class="font-mono text-[10px] uppercase tracking-[0.22em] text-sand-muted">Reply</dt>
        <dd class="font-display text-[clamp(1.5rem,3vw,2.25rem)] tracking-[0.04em] text-sand">~ 1 hour</dd>
        <dd class="font-mono text-[10px] tracking-[0.18em] text-gold-light">WhatsApp confirms 24h</dd>
      </div>
    </dl>
  </div>
</section>
