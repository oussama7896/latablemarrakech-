---
// Keep reading — editorial discovery block. One featured journal essay
// with an image plate, five supporting cluster-page links as a divided
// list on the right. Replaces the previous 3×2 utility grid.

const feature = {
  href: '/blog/marrakech-medina-market-guide/',
  eyebrow: 'The journal · Field notes',
  title: "A chef's walk through the Marrakech souk",
  body: 'Where to buy spices, fish, lamb, preserved lemons and produce — what to pay, and the unwritten rules of the food souk.',
  image: '/medina-souk-at-sunset-poster.png',
  imageAlt: 'Sunset over the Koutoubia mosque and Jemaa el-Fna — La Table chef shopping the medina souk at first light',
  meta: '8 min read · April 2026',
};

const supporting = [
  {
    href: '/private-chef-cost-marrakech/',
    title: 'How much does a private chef cost?',
    body: 'Full price breakdown — what €85 a head actually buys you.',
  },
  {
    href: '/marrakech-villa-with-private-chef/',
    title: 'Marrakech villas with a private chef',
    body: 'Where to stay so booking a chef makes sense.',
  },
  {
    href: '/the-experience/',
    title: 'The experience',
    body: 'What a service night looks like, hour by hour.',
  },
  {
    href: '/marrakech-cooking-class-vs-private-chef/',
    title: 'Cooking class vs private chef',
    body: 'Which to pick depending on your trip and your group.',
  },
  {
    href: '/services/wedding-dinner-marrakech/',
    title: 'Wedding dinners',
    body: 'For 20–80 guests across multiple courses and stations.',
  },
];
---

<section class="border-t border-gold/15 bg-ink py-16 sm:py-20">
  <div data-reveal class="container">
    {/* Header */}
    <div class="mb-14 grid grid-cols-12 items-end gap-6 sm:mb-16">
      <div class="col-span-12 md:col-span-7 lg:col-span-6">
        <span class="eyebrow inline-flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.32em] text-gold-light">
          <span aria-hidden="true" class="inline-block size-1.5 rotate-45 bg-ember"></span>
          07 · The journal
        </span>
        <h2 class="mt-6 font-display text-[clamp(2.25rem,4.5vw,3.75rem)] leading-[1] tracking-[0.04em] text-sand">
          Keep reading,
          <em class="font-serif italic font-normal text-gold-light">slowly</em>.
        </h2>
      </div>
      <div class="col-span-12 md:col-span-5 md:col-start-8 lg:col-span-5 lg:col-start-8">
        <p class="text-[15px] leading-[1.75] text-sand-muted">
          Field notes from the kitchen, the souk, and the table. Written for guests
          planning a Marrakech stay and curious about what private dining actually looks like.
        </p>
      </div>
    </div>

    {/* Editorial split — featured article + supporting list */}
    <div class="grid grid-cols-12 gap-10 lg:gap-12">

      {/* Featured — poster image left, editorial copy right */}
      <a
        href={feature.href}
        class="group relative col-span-12 isolate grid grid-cols-1 overflow-hidden border border-gold/15 bg-ink-light transition hover:border-ember/60 sm:grid-cols-12 lg:col-span-7"
      >
        {/* Image plate — natural portrait aspect on mobile, fills column height on desktop */}
        <figure class="relative sm:col-span-5">
          <div class="aspect-[3/4] sm:absolute sm:inset-0 sm:aspect-auto">
            <img
              src={feature.image}
              alt={feature.imageAlt}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition duration-[1200ms] ease-out group-hover:scale-[1.02]"
            />
          </div>
          <div class="absolute inset-0 bg-ember/10 mix-blend-multiply" aria-hidden="true"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-ink/40 via-transparent to-transparent" aria-hidden="true"></div>
        </figure>

        {/* Copy */}
        <div class="flex flex-1 flex-col gap-4 p-7 sm:col-span-7 sm:p-10 lg:p-12">
          <span class="inline-flex w-fit items-center gap-2 rounded-full border border-gold/25 bg-ink/40 px-3 py-1 font-mono text-[10px] uppercase tracking-[0.24em] text-gold-light">
            <span aria-hidden="true" class="inline-block size-1.5 rotate-45 bg-ember"></span>
            {feature.eyebrow}
          </span>
          <h3 class="font-display text-[clamp(1.65rem,2.6vw,2.4rem)] leading-[1.05] tracking-[0.02em] text-sand transition group-hover:text-gold-light">
            {feature.title}
          </h3>
          <p class="max-w-[62ch] text-[15px] leading-[1.7] text-sand-muted">
            {feature.body}
          </p>
          <div class="mt-3 flex items-center justify-between border-t border-gold/15 pt-5">
            <span class="font-mono text-[10px] uppercase tracking-[0.28em] text-sand-muted">
              {feature.meta}
            </span>
            <span class="inline-flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.24em] text-gold-light">
              Read the essay
              <span
                aria-hidden="true"
                class="inline-block h-px w-10 bg-gold/60 transition group-hover:w-16 group-hover:bg-ember"
              ></span>
            </span>
          </div>
        </div>
      </a>

      {/* Supporting list */}
      <ul class="col-span-12 flex flex-col divide-y divide-gold/15 border-y border-gold/15 lg:col-span-5">
        {supporting.map((l) => (
          <li>
            <a
              href={l.href}
              class="group grid grid-cols-[1fr_auto] items-start gap-4 py-6 transition hover:bg-ink-light/40 sm:py-7"
            >
              <div>
                <span class="font-display text-[clamp(1.05rem,1.4vw,1.4rem)] leading-snug tracking-[0.03em] text-sand transition group-hover:text-gold-light">
                  {l.title}
                </span>
                <span class="mt-2 block max-w-[52ch] text-[13.5px] leading-[1.6] text-sand-muted">
                  {l.body}
                </span>
              </div>
              <span
                aria-hidden="true"
                class="mt-1 inline-flex size-8 shrink-0 items-center justify-center rounded-full border border-gold/25 text-gold-light transition group-hover:border-ember group-hover:bg-ember group-hover:text-white"
              >
                <span class="-rotate-45 text-[14px] leading-none">↗</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    {/* Tail link to journal index */}
    <div class="mt-12 text-center">
      <a
        href="/blog/"
        class="group inline-flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.28em] text-gold-light transition hover:text-sand"
      >
        Browse the full journal
        <span
          aria-hidden="true"
          class="inline-block h-px w-10 bg-gold/60 transition group-hover:w-16 group-hover:bg-ember"
        ></span>
      </a>
    </div>
  </div>
</section>
