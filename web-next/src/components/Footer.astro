---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="brand">LA TABLE <span>· Marrakech</span></p>
      <p class="tagline">Private chef service. Souk to terrace.</p>
    </div>
    <div>
      <h4>Reach us</h4>
      <p>
        <a data-event="whatsapp_click" data-location="footer" href="https://wa.me/212721354757" rel="noopener" target="_blank">WhatsApp +212 721 354 757</a><br/>
        <a href="mailto:hello@latablemarrakech.com">hello@latablemarrakech.com</a>
      </p>
    </div>
    <div>
      <h4>Browse</h4>
      <ul>
        <li><a href="/the-experience/">The experience</a></li>
        <li><a href="/private-chef-cost-marrakech/">Pricing</a></li>
        <li><a href="/marrakech-villa-with-private-chef/">Villas</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/privacy/">Privacy</a></li>
      </ul>
    </div>
  </div>
  <p class="legal">© {year} La Table Marrakech · Derb Jdid 14, Médina, Marrakech 40000, Morocco</p>
</footer>

<style>
  .site-footer { background: #0a0704; color: var(--sand-muted); padding: 64px 0 24px; border-top: 1px solid rgba(184,147,90,0.18); margin-top: 80px; }
  .footer-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 32px; }
  .brand { font-family: var(--font-display); font-size: 22px; letter-spacing: 3px; color: var(--sand); margin: 0; }
  .brand span { font-family: var(--font-serif); font-style: italic; color: var(--gold-light); font-size: 14px; letter-spacing: 1px; margin-left: 6px; }
  .tagline { font-family: var(--font-serif); font-style: italic; color: var(--gold-light); margin: 8px 0 0; }
  h4 { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--gold); margin: 0 0 12px; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  a { color: var(--sand-muted); text-decoration: none; transition: color .2s; }
  a:hover { color: var(--sand); }
  .legal { text-align: center; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.12em; margin: 48px 0 0; opacity: 0.6; }
</style>
