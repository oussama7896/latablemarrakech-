---
// Footer — editorial multi-column composition.
// • Top sign-off band: serif headline + final WhatsApp CTA
// • Mid grid: brand block / sitemap / reach / hours
// • Bottom legal hairline
const year = new Date().getFullYear();
---

<footer class="site-footer">
  {/* Sign-off — emotional close of the page */}
  <section class="lt-foot-signoff">
    <div class="container lt-foot-signoff-inner">
      <p class="lt-foot-signoff-eyebrow">
        <span aria-hidden="true" class="lt-diamond"></span>
        Souk to terrace
      </p>
      <p class="lt-foot-signoff-head">
        Tonight, the table can be yours.
        <em>— let’s set it.</em>
      </p>
      <a
        href="https://wa.me/212721354757"
        target="_blank"
        rel="noopener noreferrer"
        data-event="whatsapp_click"
        data-location="footer-cta"
        class="lt-foot-cta"
      >
        Message us on WhatsApp
        <span aria-hidden="true" class="lt-foot-cta-arrow"></span>
      </a>
      <p class="lt-foot-signoff-sub">
        Reply within an hour · Confirmed in 24h · Minimum 2 guests
      </p>
    </div>
  </section>

  {/* Editorial grid */}
  <section class="lt-foot-grid">
    <div class="container lt-foot-grid-inner">
      <div class="lt-foot-brand">
        <p class="lt-foot-brandmark">
          <span aria-hidden="true" class="lt-diamond lt-diamond-lg"></span>
          LA TABLE <span class="lt-foot-brandmark-sub">· Marrakech</span>
        </p>
        <p class="lt-foot-tag">
          Private chef service for villas and riads in Marrakech.
          Souk-fresh, multi-course, full hospitality.
        </p>
        <a
          href="https://www.instagram.com/latablemarrakech"
          target="_blank"
          rel="noopener"
          class="lt-foot-ig"
          aria-label="La Table Marrakech on Instagram"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5"/>
            <circle cx="12" cy="12" r="4"/>
            <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor"/>
          </svg>
          @latablemarrakech
        </a>
      </div>

      <div class="lt-foot-col">
        <h4>Browse</h4>
        <ul>
          <li><a href="/the-experience/">The experience</a></li>
          <li><a href="/menus/">Menus</a></li>
          <li><a href="/private-chef-cost-marrakech/">Pricing</a></li>
          <li><a href="/marrakech-villa-with-private-chef/">Villas</a></li>
          <li><a href="/areas-we-serve/">Areas we serve</a></li>
          <li><a href="/blog/">Journal</a></li>
        </ul>
      </div>

      <div class="lt-foot-col">
        <h4>Reach us</h4>
        <ul>
          <li><a data-event="whatsapp_click" data-location="footer" href="https://wa.me/212721354757" rel="noopener" target="_blank">WhatsApp · +212 721 354 757</a></li>
          <li><a href="mailto:hello@latablemarrakech.com">hello@latablemarrakech.com</a></li>
          <li><a href="/contact/">Contact form</a></li>
          <li><a href="/faq/">FAQ</a></li>
        </ul>
      </div>

      <div class="lt-foot-col">
        <h4>The studio</h4>
        <address>
          Derb Jdid 14, Médina<br/>
          40000 Marrakech, Morocco
        </address>
        <p class="lt-foot-hours">
          Service · 7 days a week<br/>
          Office · 09:00 — 21:00 GMT+1
        </p>
      </div>
    </div>
  </section>

  {/* Legal hairline */}
  <div class="lt-foot-legal container">
    <span>© {year} La Table Marrakech · All rights reserved</span>
    <span class="lt-foot-legal-links">
      <a href="/privacy/">Privacy</a>
      <span aria-hidden="true">·</span>
      <a href="/faq/">Terms</a>
    </span>
  </div>
</footer>

<style>
  .site-footer {
    background: #08060a; color: var(--sand-muted);
    border-top: 1px solid rgba(184,147,90,0.18);
    margin-top: 80px;
  }

  .lt-diamond {
    display: inline-block; width: 7px; height: 7px;
    background: var(--ember); transform: rotate(45deg);
    vertical-align: middle; margin-right: 6px;
  }
  .lt-diamond-lg { width: 10px; height: 10px; }

  /* --- Sign-off band --- */
  .lt-foot-signoff {
    border-bottom: 1px solid rgba(184,147,90,0.12);
    padding: 80px 0 88px;
    text-align: center;
    background: radial-gradient(ellipse at center, rgba(184,79,46,0.06), transparent 70%);
  }
  .lt-foot-signoff-inner { display: flex; flex-direction: column; align-items: center; gap: 22px; }
  .lt-foot-signoff-eyebrow {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.32em;
    text-transform: uppercase; color: var(--gold-light); margin: 0;
    display: inline-flex; align-items: center; gap: 10px;
  }
  .lt-foot-signoff-head {
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(2rem, 4.5vw, 3.25rem); line-height: 1.05;
    letter-spacing: 0.03em; color: var(--sand); margin: 0;
    max-width: 720px;
  }
  .lt-foot-signoff-head em {
    display: block; margin-top: 10px;
    font-family: var(--font-serif); font-style: italic;
    font-size: 0.55em; color: var(--gold-light);
  }
  .lt-foot-cta {
    display: inline-flex; align-items: center; gap: 12px;
    padding: 16px 32px; border-radius: 999px;
    background: var(--ember); color: #fff !important; text-decoration: none;
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.22em;
    text-transform: uppercase;
    box-shadow: 0 22px 50px -16px rgba(184,79,46,0.55);
    transition: transform .25s, background .25s;
    margin-top: 6px;
  }
  .lt-foot-cta:hover { background: var(--ember-light); transform: translateY(-1px); }
  .lt-foot-cta-arrow {
    width: 8px; height: 8px; background: #fff; transform: rotate(45deg);
    display: inline-block; transition: transform .25s;
  }
  .lt-foot-cta:hover .lt-foot-cta-arrow { transform: rotate(45deg) translateY(-1px); }
  .lt-foot-signoff-sub {
    margin: 0; font-family: var(--font-mono); font-size: 11px;
    letter-spacing: 0.22em; text-transform: uppercase; color: var(--sand-muted);
  }

  /* --- Multi-column grid --- */
  .lt-foot-grid { padding: 72px 0 56px; }
  .lt-foot-grid-inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 56px;
  }
  @media (max-width: 900px) {
    .lt-foot-grid-inner { grid-template-columns: 1fr 1fr; gap: 40px; }
    .lt-foot-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 540px) {
    .lt-foot-grid-inner { grid-template-columns: 1fr; gap: 36px; }
  }

  .lt-foot-brandmark {
    font-family: var(--font-display); font-size: 22px;
    letter-spacing: 3px; color: var(--sand); margin: 0 0 16px;
  }
  .lt-foot-brandmark-sub {
    font-family: var(--font-serif); font-style: italic;
    font-size: 13px; color: var(--gold-light);
    letter-spacing: 1px; margin-left: 4px;
  }
  .lt-foot-tag {
    margin: 0 0 24px; max-width: 36ch;
    font-family: var(--font-serif); font-style: italic;
    font-size: 15px; line-height: 1.6; color: var(--gold-light);
  }
  .lt-foot-ig {
    display: inline-flex; align-items: center; gap: 10px;
    font-family: var(--font-mono); font-size: 11px;
    letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--sand-muted); text-decoration: none;
    padding: 8px 14px; border: 1px solid rgba(184,147,90,0.2);
    border-radius: 999px; transition: color .25s, border-color .25s;
  }
  .lt-foot-ig:hover { color: var(--sand); border-color: var(--ember); }

  .lt-foot-col h4 {
    font-family: var(--font-mono); font-size: 10px;
    letter-spacing: 0.28em; text-transform: uppercase;
    color: var(--gold); margin: 0 0 16px;
  }
  .lt-foot-col ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .lt-foot-col a, .lt-foot-col address {
    font-style: normal; font-family: var(--font-body, system-ui, sans-serif);
    font-size: 14px; line-height: 1.6; color: var(--sand-muted);
    text-decoration: none; transition: color .25s;
  }
  .lt-foot-col a:hover { color: var(--sand); }
  .lt-foot-hours {
    margin: 14px 0 18px; font-family: var(--font-mono);
    font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--sand-muted); line-height: 1.8;
  }
  .lt-foot-lang { display: flex; gap: 4px; }
  .lt-foot-lang a {
    padding: 6px 10px; border: 1px solid rgba(184,147,90,0.2);
    border-radius: 4px; font-family: var(--font-mono);
    font-size: 10px; letter-spacing: 1px; color: var(--sand-muted);
    text-decoration: none;
  }
  .lt-foot-lang a:hover { color: var(--sand); border-color: var(--ember); }

  /* --- Legal hairline --- */
  .lt-foot-legal {
    display: flex; justify-content: space-between; align-items: center;
    padding: 24px 0; flex-wrap: wrap; gap: 12px;
    border-top: 1px solid rgba(184,147,90,0.1);
    font-family: var(--font-mono); font-size: 10px;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--sand-muted); opacity: 0.85;
  }
  .lt-foot-legal-links { display: inline-flex; gap: 10px; }
  .lt-foot-legal a { color: var(--sand-muted); text-decoration: none; transition: color .25s; }
  .lt-foot-legal a:hover { color: var(--sand); }
</style>
