---
// Signature Experiences — bento-style editorial grid of five private chef
// scenarios. One hero tile + four supporting tiles. No CTA copy on the cards
// themselves; the whole section funnels back to the existing #booking anchor.
// Image overlay gradient + gold hairline border keeps it in the Hyperagent
// system already established by Hero/Features.

const experiences = [
  {
    slug: 'villa-chef',
    eyebrow: 'Chef for the stay',
    title: 'Villa Chef Experience',
    body: 'Three, five, seven nights. A chef who plans every menu around your villa, your guests, your day.',
    image: '/moroccan-feast-villa-terrace.webp',
    span: 'lg:col-span-8 lg:row-span-2',
    aspect: 'aspect-[16/11] lg:aspect-auto lg:min-h-[560px]',
  },
  {
    slug: 'romantic-dinner',
    eyebrow: 'For two',
    title: 'Romantic Dinner',
    body: 'Candlelight, rose petals, a tasting menu. Plated course by course on your terrace.',
    image: '/private-chef-marrakech-tagine.webp',
    span: 'lg:col-span-4',
    aspect: 'aspect-[5/4] lg:aspect-[5/4]',
  },
  {
    slug: 'rooftop-sunset',
    eyebrow: 'Magic hour',
    title: 'Rooftop Sunset Dinner',
    body: 'Mint tea at golden hour. Pastilla and grilled mezze as the Atlas turns pink.',
    image: '/seafood-pastilla-shrimp.webp',
    span: 'lg:col-span-4',
    aspect: 'aspect-[5/4]',
  },
  {
    slug: 'family-feast',
    eyebrow: 'For the table',
    title: 'Family Style Feast',
    body: 'Seven-vegetable couscous, slow-cooked lamb, saffron broth. Served from clay tagines, the way it should be.',
    image: '/seven-vegetable-couscous.webp',
    span: 'lg:col-span-4',
    aspect: 'aspect-[5/4]',
  },
  {
    slug: 'celebration',
    eyebrow: 'Anniversaries · Birthdays · Weddings',
    title: 'Celebration Dinner',
    body: 'Bespoke menus for ten to forty. Signature dishes, a tasting flight, dessert presented at the table.',
    image: '/chef-cooking-marrakech-kitchen.webp',
    span: 'lg:col-span-4',
    aspect: 'aspect-[5/4]',
  },
];
---

<section id="experiences" class="bg-ink py-24 sm:py-28">
  <div data-reveal class="container">
    {/* Section header — matches the eyebrow rhythm used elsewhere */}
    <div class="mx-auto max-w-[760px] text-center">
      <span class="eyebrow inline-flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.32em] text-gold-light">
        <span aria-hidden="true" class="inline-block size-1.5 rotate-45 bg-ember"></span>
        03 · Signature experiences
      </span>
      <h2 class="mt-6 font-display text-[clamp(2.25rem,4.5vw,3.75rem)] leading-[1] tracking-[0.04em] text-sand">
        Five ways to set the
        <em class="font-serif italic font-normal text-gold-light">table</em>.
      </h2>
      <p class="mx-auto mt-6 max-w-[540px] text-[15px] leading-[1.7] text-sand-muted">
        From a quiet dinner for two to a feast for forty — every experience is built
        around your villa, your menu, your evening.
      </p>
    </div>

    {/* Bento grid — 12 columns on desktop, single column on mobile */}
    <div class="mt-16 grid grid-cols-1 gap-3 sm:gap-4 lg:grid-cols-12 lg:gap-5">
      {experiences.map(({ slug, eyebrow, title, body, image, span, aspect }) => (
        <article
          data-experience={slug}
          class={`lt-exp group relative isolate overflow-hidden border border-gold/15 bg-ink-light ${span}`}
        >
          {/* Image plate */}
          <div class={`absolute inset-0 ${aspect}`}>
            <img
              src={image}
              alt=""
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition duration-[1200ms] ease-[cubic-bezier(.2,.7,.2,1)] group-hover:scale-[1.04]"
            />
            {/* Layered overlay — color treatment + readability gradient */}
            <div class="absolute inset-0 bg-ember/15 mix-blend-multiply" aria-hidden="true"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/55 to-transparent" aria-hidden="true"></div>
          </div>

          {/* Content over the image */}
          <div class={`relative flex flex-col justify-end gap-3 p-7 sm:p-8 ${aspect}`}>
            <span class="font-mono text-[10px] uppercase tracking-[0.28em] text-gold-light">
              {eyebrow}
            </span>
            <h3 class="font-display text-[clamp(1.5rem,2.4vw,2.25rem)] leading-[1.05] tracking-[0.02em] text-sand">
              {title}
            </h3>
            <p class="max-w-[42ch] text-[14px] leading-[1.65] text-sand/85">
              {body}
            </p>
            {/* Hairline reveal on hover */}
            <span
              aria-hidden="true"
              class="mt-3 inline-block h-px w-12 origin-left scale-x-0 bg-gold/70 transition duration-700 ease-out group-hover:scale-x-100"
            ></span>
          </div>
        </article>
      ))}
    </div>

    {/* Quiet anchor back to booking — no chrome */}
    <div class="mt-14 text-center">
      <a
        href="#booking"
        class="group inline-flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.28em] text-gold-light transition hover:text-sand"
      >
        Book your dinner
        <span
          aria-hidden="true"
          class="inline-block h-px w-10 bg-gold/60 transition group-hover:w-16 group-hover:bg-ember"
        ></span>
      </a>
    </div>
  </div>
</section>

<style>
  /* Small refinement — the bento large tile needs the image plate to fill
     the entire stretched row on lg+, not just the aspect ratio fallback. */
  @media (min-width: 1024px) {
    .lt-exp { display: block; }
    .lt-exp > div:first-child { position: absolute; inset: 0; aspect-ratio: auto !important; }
    .lt-exp > div:last-child { position: relative; aspect-ratio: auto !important; min-height: inherit; height: 100%; }
  }
</style>
