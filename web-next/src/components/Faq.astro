---
import faqs from '@/data/home-faqs.json';
---

<section class="faqs" id="faqs">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">05 · QUESTIONS</span>
      <h2>FAQ</h2>
    </div>
    <div class="faq-list">
      {faqs.map((f: { q: string; a: string }) => (
        /* <details>/<summary> is what the analytics listener uses for faq_open. */
        <details class="faq-item">
          <summary class="faq-question">
            <span>{f.q}</span>
            <span class="icon" aria-hidden="true">+</span>
          </summary>
          <div class="faq-answer">
            <p>{f.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faqs { padding: 80px 0; background: var(--ink-light); }
  .section-header { text-align: center; margin-bottom: 48px; }
  .section-header h2 { font-family: var(--font-display); font-size: clamp(36px, 5vw, 64px); letter-spacing: 0.04em; color: var(--sand); margin: 12px 0 0; }
  .faq-list { max-width: 760px; margin: 0 auto; display: grid; gap: 0; }
  .faq-item { border-bottom: 1px solid rgba(184,147,90,0.18); padding: 0; }
  .faq-question { list-style: none; cursor: pointer; padding: 22px 0; display: flex; justify-content: space-between; align-items: center; gap: 16px; font-family: var(--font-serif); font-size: 18px; color: var(--sand); width: 100%; background: transparent; border: 0; text-align: left; }
  .faq-question::-webkit-details-marker { display: none; }
  .faq-question .icon { font-family: var(--font-display); font-size: 24px; color: var(--ember); transition: transform .3s; }
  details[open] .faq-question .icon { transform: rotate(45deg); }
  .faq-answer { padding: 0 0 22px; color: var(--sand-muted); line-height: 1.65; max-width: 64ch; }
  .faq-answer p { margin: 0; }
</style>
