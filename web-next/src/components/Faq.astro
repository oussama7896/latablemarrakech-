---
// FAQ — editorial two-column. Sticky title rail on the left, accordion on
// the right. Uses <details>/<summary> so the analytics listener in
// Layout.astro still fires faq_open on toggle. First item open by default
// (a reader sees an answer immediately, not a list of closed questions).
import faqs from '@/data/home-faqs.json';

type Faq = { q: string; a: string };
const list = faqs as Faq[];
---

<section class="lt-faq bg-ink-light py-16 sm:py-20" id="faqs">
  <div data-reveal class="container">
    <div class="grid grid-cols-12 gap-x-8 gap-y-12 lg:gap-x-16">

      {/* Left rail */}
      <aside class="col-span-12 lg:col-span-4">
        <div class="lg:sticky lg:top-28">
          <span class="eyebrow inline-flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.32em] text-gold-light">
            <span aria-hidden="true" class="inline-block size-1.5 rotate-45 bg-ember"></span>
            06 · Questions
          </span>
          <h2 class="mt-6 font-display text-[clamp(2.25rem,4vw,3.5rem)] leading-[1.02] tracking-[0.03em] text-sand">
            Before you write,
            <em class="mt-1 block font-serif italic font-normal text-gold-light">a few answers.</em>
          </h2>
          <p class="mt-6 max-w-[42ch] text-[15px] leading-[1.75] text-sand-muted">
            The ones we hear most often. If yours isn’t here, the fastest reply will
            always be on WhatsApp — usually within an hour.
          </p>

          <a
            href="https://wa.me/212721354757"
            target="_blank"
            rel="noopener noreferrer"
            data-event="whatsapp_click"
            data-location="faq-side"
            class="group mt-10 inline-flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.28em] text-gold-light transition hover:text-sand"
          >
            Still curious? Ask on WhatsApp
            <span
              aria-hidden="true"
              class="inline-block h-px w-10 bg-gold/60 transition group-hover:w-16 group-hover:bg-ember"
            ></span>
          </a>
        </div>
      </aside>

      {/* Accordion column */}
      <div class="col-span-12 lg:col-span-8">
        <ul class="border-t border-gold/15">
          {list.map((f, i) => (
            <li>
              <details class="lt-faq-item" {...(i === 0 ? { open: true } : {})}>
                <summary class="lt-faq-summary faq-question">
                  <span class="lt-faq-q">{f.q}</span>
                  <span aria-hidden="true" class="lt-faq-icon"></span>
                </summary>
                <div class="lt-faq-answer">
                  <div class="lt-faq-answer-inner">
                    <p>{f.a}</p>
                  </div>
                </div>
              </details>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .lt-faq-item {
    border-bottom: 1px solid rgba(184,147,90,0.15);
    padding: 0;
  }
  .lt-faq-summary {
    list-style: none;
    cursor: pointer;
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    padding: 26px 0;
    font-family: var(--font-serif);
    font-size: clamp(16px, 1.4vw, 19px);
    line-height: 1.45;
    color: var(--sand);
    transition: color .3s ease;
  }
  .lt-faq-summary::-webkit-details-marker { display: none; }
  .lt-faq-summary:hover { color: var(--gold-light); }
  .lt-faq-q { flex: 1; }

  /* Rotated diamond chevron — open state flips to a horizontal minus */
  .lt-faq-icon {
    position: relative;
    width: 14px; height: 14px;
    flex-shrink: 0;
    transition: transform .35s cubic-bezier(.2,.7,.2,1);
  }
  .lt-faq-icon::before,
  .lt-faq-icon::after {
    content: ''; position: absolute; inset: 0;
    background: var(--ember);
    transition: opacity .3s ease, transform .35s ease;
  }
  .lt-faq-icon::before { clip-path: polygon(50% 0,100% 50%,50% 100%,0 50%); }
  .lt-faq-icon::after  { clip-path: polygon(50% 30%,70% 50%,50% 70%,30% 50%); background: var(--ink-light); }
  details[open] .lt-faq-icon { transform: rotate(45deg); }
  details[open] .lt-faq-summary { color: var(--gold-light); }

  /* Smooth open transition — grid-template-rows technique animates 0fr → 1fr
     instead of max-height, so it's GPU-friendly and works for any answer length. */
  .lt-faq-answer {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    padding-inline-end: 24px;
    transition: grid-template-rows .55s cubic-bezier(.2,.7,.2,1), opacity .35s ease;
  }
  .lt-faq-answer-inner {
    overflow: hidden;
    min-height: 0;
  }
  details[open] .lt-faq-answer {
    grid-template-rows: 1fr;
    opacity: 1;
    padding-bottom: 26px;
  }
  .lt-faq-answer p {
    margin: 0;
    max-width: 64ch;
    color: var(--sand-muted);
    line-height: 1.75;
    font-size: 15px;
  }

  @media (prefers-reduced-motion: reduce) {
    .lt-faq-icon, .lt-faq-answer { transition: none; }
  }
</style>
