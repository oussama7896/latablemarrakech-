---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://latablemarrakech.com/' },
    { '@type': 'ListItem', position: 2, name: 'Privacy Policy', item: 'https://latablemarrakech.com/privacy/' },
  ],
};

const sections = [
  { title: 'Who we are', body: 'La Table Marrakech is a private chef service operating in Marrakech, Morocco. Contact us at <a href="mailto:hello@latablemarrakech.com" class="text-ember-light hover:text-gold-light underline-offset-4 hover:underline">hello@latablemarrakech.com</a>.' },
  { title: 'What data we collect', body: 'When you submit a booking request, we collect your name, email, date, time, number of guests, and any notes you provide. This information is sent directly to our WhatsApp business number to process your booking. We do not store this data on any server we control.' },
  { title: 'How we use your data', body: 'We use your information solely to: respond to your booking enquiry, confirm the reservation, coordinate the service night, and follow up after. We never sell or share your personal data with marketers.' },
  { title: 'Cookies', body: 'This website uses minimal cookies. We use Google Analytics 4 (GA4) and Google Ads conversion tracking to improve our service. These cookies only activate after you accept them via our cookie banner. Pixel data is processed by Google in line with their privacy practices.' },
  { title: 'Third parties', body: 'Your booking data is transmitted via WhatsApp (operated by Meta). We use Google Fonts for typography. No data is sold to third parties.' },
  { title: 'Your rights', body: 'You have the right to access, correct, or delete any personal data we hold. Contact us at <a href="mailto:hello@latablemarrakech.com" class="text-ember-light hover:text-gold-light underline-offset-4 hover:underline">hello@latablemarrakech.com</a> for any privacy-related requests.' },
  { title: 'Data retention', body: 'We retain booking communications for up to 12 months for service quality purposes, then delete them.' },
];
---

<Layout
  title="Privacy Policy | La Table Marrakech"
  description="Privacy Policy for La Table Marrakech — how we collect, use, and protect your personal data."
  canonical="https://latablemarrakech.com/privacy/"
  htmlLang="en"
  robots="noindex, follow"
  hreflang={[
    { hreflang: 'en', href: 'https://latablemarrakech.com/privacy/' },
    { hreflang: 'fr', href: 'https://latablemarrakech.com/fr/privacy/' },
    { hreflang: 'ar', href: 'https://latablemarrakech.com/ar/privacy/' },
    { hreflang: 'x-default', href: 'https://latablemarrakech.com/privacy/' },
  ]}
  jsonLd={[breadcrumbLd]}
>
  <Nav lang="en" />

  <main>
    <header class="bg-ink-light pb-14 pt-20 sm:pt-24">
      <div class="container">
        <nav class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.22em] text-sand-muted" aria-label="Breadcrumb">
          <a href="/" class="hover:text-gold-light">Home</a>
          <span aria-hidden="true" class="text-ember">◆</span>
          <span class="text-gold-light">Privacy Policy</span>
        </nav>
        <h1 class="mt-8 font-display text-[clamp(2.5rem,5.5vw,4.5rem)] leading-[0.95] tracking-[0.04em] text-sand">
          Privacy <em class="font-serif italic font-normal text-gold-light">policy</em>
        </h1>
        <p class="mt-4 font-mono text-[11px] uppercase tracking-[0.22em] text-sand-muted">
          Last updated: April 2026
        </p>
      </div>
    </header>

    <section class="bg-ink py-20">
      <article class="container max-w-[760px] space-y-10">
        {sections.map((s) => (
          <section>
            <h2 class="font-display text-[clamp(1.5rem,3vw,2.25rem)] tracking-[0.04em] text-sand">{s.title}</h2>
            <p class="mt-3 leading-[1.75] text-sand-muted" set:html={s.body} />
          </section>
        ))}
      </article>
    </section>
  </main>

  <Footer />
</Layout>
