---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://latablemarrakech.com/' },
    { '@type': 'ListItem', position: 2, name: 'Areas We Serve', item: 'https://latablemarrakech.com/areas-we-serve/' },
  ],
};

const areas = [
  { name: 'Palmeraie', body: 'Luxury villas and palm-lined estates — we bring elevated tasting menus and full-service staff for private events.' },
  { name: 'Medina', body: 'Authentic market-sourced menus served in riads and private courtyards — perfect for intimate gatherings.' },
  { name: 'Gueliz', body: 'Modern villas and apartments — menu options that combine Moroccan and Mediterranean touches.' },
  { name: 'Hivernage', body: 'Hotel villas and event spaces — elegant plated menus and cocktail receptions available.' },
  { name: 'Amelkis', body: 'Golf estates and family villas — casual to elevated menus for all group sizes.' },
  { name: 'Ourika Valley', body: 'Day trips and private events in the valley — we handle logistics and a full market-to-table experience.' },
];
---

<Layout
  title="Private Chef Service Across Marrakech | La Table Marrakech"
  description="Private chef service across Marrakech — Palmeraie, Medina, Hivernage, Gueliz, Amelkis, Ourika Valley. Travel inside the city is included; valley + desert add a flat transport fee."
  canonical="https://latablemarrakech.com/areas-we-serve/"
  htmlLang="en"
  hreflang={[
    { hreflang: 'en', href: 'https://latablemarrakech.com/areas-we-serve/' },
    { hreflang: 'fr', href: 'https://latablemarrakech.com/fr/areas-we-serve/' },
    { hreflang: 'ar', href: 'https://latablemarrakech.com/ar/areas-we-serve/' },
    { hreflang: 'x-default', href: 'https://latablemarrakech.com/areas-we-serve/' },
  ]}
  jsonLd={[breadcrumbLd]}
>
  <Nav lang="en" />

  <main>
    <header class="bg-ink-light pb-14 pt-20 sm:pt-24">
      <div class="container">
        <nav class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.22em] text-sand-muted" aria-label="Breadcrumb">
          <a href="/" class="hover:text-gold-light">Home</a>
          <span aria-hidden="true" class="text-ember">◆</span>
          <span class="text-gold-light">Areas We Serve</span>
        </nav>
        <span class="eyebrow mt-8 inline-flex items-center gap-3"><span class="inline-block size-1.5 rotate-45 bg-ember"></span>Six areas across Marrakech</span>
        <h1 class="mt-6 font-display text-[clamp(2.5rem,5.5vw,4.5rem)] leading-[0.95] tracking-[0.04em] text-sand">
          Private chef service
          <em class="mt-2 block font-serif italic font-normal text-[0.55em] text-gold-light">across Marrakech.</em>
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-sand">
          We operate across central Marrakech and selected nearby areas. Travel inside the city is included;
          the Atlas valleys and Agafay desert add a flat transport fee.
        </p>
      </div>
    </header>

    <section class="bg-ink py-20">
      <div class="container max-w-[900px]">
        <div class="grid gap-4 sm:grid-cols-2">
          {areas.map((a) => (
            <article class="border border-gold/20 border-t-[3px] border-t-ember bg-ink-light p-6">
              <h2 class="font-display text-[1.5rem] tracking-[0.04em] text-sand">{a.name}</h2>
              <p class="mt-3 text-[15px] leading-relaxed text-sand-muted">{a.body}</p>
              <p class="mt-4">
                <a
                  data-event="whatsapp_click" data-location="areas"
                  href={`https://wa.me/212721354757?text=I%27d%20like%20a%20chef%20in%20${encodeURIComponent(a.name)}`}
                  target="_blank" rel="noopener noreferrer"
                  class="font-mono text-[11px] uppercase tracking-[0.22em] text-ember-light hover:text-gold-light underline-offset-4 hover:underline"
                >
                  Book a chef in {a.name} →
                </a>
              </p>
            </article>
          ))}
        </div>

        <p class="mt-10 text-center text-sand-muted">
          Anywhere we don't list — <a
            data-event="whatsapp_click" data-location="areas"
            href="https://wa.me/212721354757"
            target="_blank" rel="noopener noreferrer"
            class="text-ember-light hover:text-gold-light underline-offset-4 hover:underline"
          >ask</a>. We've cooked from Essaouira to the Atlas to the desert.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
