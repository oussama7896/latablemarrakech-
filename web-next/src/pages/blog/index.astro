---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import posts from '@/data/blog-posts.json';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://latablemarrakech.com/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://latablemarrakech.com/blog/' },
  ],
};
---

<Layout
  title="Blog | La Table Marrakech"
  description="Articles about private chef dining, Moroccan food and villa events in Marrakech."
  canonical="https://latablemarrakech.com/blog/"
  htmlLang="en"
  hreflang={[
    { hreflang: 'en', href: 'https://latablemarrakech.com/blog/' },
    { hreflang: 'x-default', href: 'https://latablemarrakech.com/blog/' },
  ]}
  jsonLd={[breadcrumbLd]}
>
  <Nav lang="en" />

  <main>
    <header class="bg-ink-light pb-14 pt-24">
      <div class="container">
        <nav class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.22em] text-sand-muted" aria-label="Breadcrumb">
          <a href="/" class="hover:text-gold-light">Home</a>
          <span aria-hidden="true" class="text-ember">◆</span>
          <span class="text-gold-light">Journal</span>
        </nav>
        <h1 class="mt-8 font-display text-[clamp(2.5rem,5.5vw,4.5rem)] leading-[0.95] tracking-[0.04em] text-sand">
          Journal
          <em class="mt-2 block font-serif italic font-normal text-[0.55em] text-gold-light">— from a Marrakech kitchen.</em>
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-sand">
          Notes from the souk, recipes, pricing thinking, and longer-form reading on private dining in Marrakech.
        </p>
      </div>
    </header>

    <section class="bg-ink py-20">
      <div class="container max-w-[860px]">
        <ul class="grid gap-4">
          {posts.map((p: { slug: string; title: string; summary: string; date: string; readTime: string }) => (
            <li>
              <a href={`/blog/${p.slug}/`} class="group block border border-gold/20 border-l-[4px] border-l-ember bg-ink-light p-7 transition hover:border-l-ember-light hover:bg-ink">
                <div class="flex items-center gap-4 font-mono text-[10px] uppercase tracking-[0.22em] text-sand-muted">
                  <time datetime={p.date}>{new Date(p.date).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
                  <span aria-hidden="true" class="size-1 rotate-45 bg-ember"></span>
                  <span>{p.readTime}</span>
                </div>
                <h2 class="mt-3 font-serif text-[22px] leading-snug text-sand transition group-hover:text-gold-light">{p.title}</h2>
                <p class="mt-3 text-[15px] leading-relaxed text-sand-muted">{p.summary}</p>
                <span class="mt-4 inline-block font-mono text-[11px] uppercase tracking-[0.22em] text-ember">Read →</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
