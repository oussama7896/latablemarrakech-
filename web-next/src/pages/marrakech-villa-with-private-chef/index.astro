---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://latablemarrakech.com/' },
    { '@type': 'ListItem', position: 2, name: 'Marrakech Villa with Private Chef', item: 'https://latablemarrakech.com/marrakech-villa-with-private-chef/' },
  ],
};

const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: 'Marrakech Villas With a Private Chef: 2026 Guide & Booking Tips',
  description: 'A complete guide to renting a Marrakech villa or riad with a private chef. Neighbourhoods, kitchen requirements, sample itineraries, and how to book.',
  image: 'https://latablemarrakech.com/la-table-marrakech-og.png',
  datePublished: '2026-04-27T08:00:00+01:00', dateModified: '2026-04-27T08:00:00+01:00',
  author: { '@type': 'Organization', name: 'La Table Marrakech', url: 'https://latablemarrakech.com/' },
  publisher: { '@type': 'Organization', name: 'La Table Marrakech', logo: { '@type': 'ImageObject', url: 'https://latablemarrakech.com/la-table-marrakech-og.png' } },
  mainEntityOfPage: 'https://latablemarrakech.com/marrakech-villa-with-private-chef/',
};

const faqs = [
  { q: 'Can I rent a villa in Marrakech with a private chef included?', a: 'Yes — most luxury villa rentals in the Palmeraie and the Hivernage offer a chef as a paid add-on, typically €60–€150 per person per day. Or you can rent the villa standalone (cheaper) and bring your own chef from La Table Marrakech at €85 per person, all-inclusive.' },
  { q: 'Will the chef shop the souk?', a: 'Yes, every morning. The souk run is what makes the food taste different from a hotel buffet.' },
  { q: 'Do we need a kitchen for the chef?', a: 'Yes — oven, gas hob, sink, fridge. We bring everything else.' },
  { q: 'Can the chef cook outside / by the pool / in the desert?', a: 'Yes, with notice. Outdoor cooking with charcoal or a wood fire is one of the things we do best.' },
];

const faqLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const neighbourhoods = [
  { name: 'Palmeraie', best: 'Groups, pool dinners, families', meta: 'Resort · spacious kitchen · 15 min souk' },
  { name: 'Hivernage', best: 'Shorter trips, nightlife crossover', meta: 'Chic urban · medium kitchen · 10 min walk' },
  { name: 'Medina riads', best: 'Atmosphere, intimate dinners, couples', meta: 'Traditional · compact kitchen · souk at the door' },
  { name: 'Ourika / Atlas', best: 'Retreats, quiet, mountain views', meta: 'Countryside · variable kitchen · 45–90 min' },
];

const kitchenNeeds = ['Working oven and gas hob (4 burners ideal)', 'Hot water and a working sink', 'Refrigerator with at least one shelf empty', 'Plates and glasses for the headcount', 'A dining surface — long table outside is best'];

const steps = [
  { n: '01', title: 'Message us on WhatsApp', body: 'Date, headcount, address (or just the neighbourhood). Reply usually inside an hour.' },
  { n: '02', title: 'We send a draft menu', body: 'In writing, usually 5 courses, customised to your dietaries. You edit, we adjust.' },
  { n: '03', title: 'You confirm', body: '50% deposit via Stripe / wire. Final menu locked.' },
  { n: '04', title: 'The night', body: 'Chef arrives 4 hours before service with everything. You don’t lift a finger.' },
];
---

<Layout
  title="Marrakech Villas With a Private Chef: 2026 Guide & Booking Tips | La Table"
  description="Renting a villa or riad in Marrakech and want a chef? Here's where to stay (Palmeraie, Medina, Hivernage), what to ask, and how to book — from a Marrakech-based chef team."
  twitterTitle="Marrakech Villas With a Private Chef: 2026 Guide"
  twitterDescription="Where to stay, what to ask, how to book — written by Marrakech chefs."
  canonical="https://latablemarrakech.com/marrakech-villa-with-private-chef/"
  ogLocale="en_US"
  ogLocaleAlternates={["fr_FR"]}
  htmlLang="en"
  hreflang={[
    { hreflang: 'en', href: 'https://latablemarrakech.com/marrakech-villa-with-private-chef/' },
    { hreflang: 'fr', href: 'https://latablemarrakech.com/fr/villa-marrakech-chef-prive/' },
    { hreflang: 'x-default', href: 'https://latablemarrakech.com/marrakech-villa-with-private-chef/' },
  ]}
  jsonLd={[breadcrumbLd, articleLd, faqLd]}
>
  <Nav lang="en" />

  <main class="bg-ink">
    {/* Hero */}
    <header class="pt-24 pb-16 sm:pt-32 sm:pb-20">
      <div class="container flex flex-col items-center gap-8 text-center">
        <nav class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.22em] text-sand-muted" aria-label="Breadcrumb">
          <a href="/" class="hover:text-gold-light">Home</a>
          <span aria-hidden="true" class="text-ember">◆</span>
          <span class="text-gold-light">Villa Dining Guide</span>
        </nav>
        <span class="inline-flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.32em] text-gold-light">
          <span aria-hidden="true" class="inline-block size-1.5 rotate-45 bg-ember"></span>
          The villa playbook · Updated 2026-04
        </span>
        <h1 class="max-w-[860px] font-display text-[clamp(2.75rem,7vw,5.5rem)] font-normal leading-[0.92] tracking-[0.02em] text-sand">
          A Marrakech villa
          <em class="mt-3 block font-serif italic font-normal text-[0.45em] text-gold-light">with a private chef.</em>
        </h1>
        <p class="max-w-[640px] text-[17px] leading-[1.7] text-sand">
          Where to stay, what to ask the rental, what your kitchen needs, sample 3 / 5 / 7-day itineraries —
          and how to bring us in. Written by a Marrakech-based chef team.
        </p>
      </div>
    </header>

    {/* Why villa + chef */}
    <section class="border-t border-gold/15 py-24">
      <div class="container mx-auto max-w-[760px]">
        <h2 class="text-center font-display text-[clamp(1.75rem,3.5vw,2.75rem)] tracking-[0.04em] text-sand">
          Why villa + private chef
          <em class="block font-serif italic font-normal text-gold-light">is the move</em>
        </h2>
        <p class="mx-auto mt-8 max-w-[640px] text-[17px] leading-[1.75] text-sand">
          The best week we cooked last year was a family of seven who rented a four-bedroom in the Palmeraie
          and brought us in three of their seven nights. They woke up to bread on the table, swam between
          meals, and ate dinner outside next to the pool. They never had to think about a reservation, a taxi
          back from the medina, or whether the kids would eat the menu.
        </p>
        <p class="mx-auto mt-4 max-w-[640px] text-[17px] leading-[1.75] text-sand">
          The maths usually works. A Palmeraie villa for 8 guests rents for €400–1,200 per night. A
          chef-included package adds €90–150 per person per day. Bringing your own chef like us is
          <strong class="text-sand">€85 per person, all-inclusive</strong> — same fine-dining quality, more bespoke menus.
        </p>
      </div>
    </section>

    {/* Neighbourhoods — Hyperagent uses simple data rows; we follow */}
    <section class="border-t border-gold/15 py-24">
      <div class="container mx-auto max-w-[920px]">
        <h2 class="text-center font-display text-[clamp(1.75rem,3.5vw,2.75rem)] tracking-[0.04em] text-sand">
          Where you'll be cooking
          <em class="block font-serif italic font-normal text-gold-light">— pick your neighbourhood</em>
        </h2>
        <ul class="mt-12 grid gap-px overflow-hidden rounded-md bg-gold/15">
          {neighbourhoods.map((n) => (
            <li class="grid gap-2 bg-ink p-7 sm:grid-cols-[200px_1fr_minmax(0,auto)] sm:items-baseline sm:gap-8">
              <h3 class="font-display text-[1.5rem] tracking-[0.04em] text-sand">{n.name}</h3>
              <p class="text-[15px] leading-[1.65] text-sand">Best for: <strong class="text-sand">{n.best}</strong>.</p>
              <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-gold-light">{n.meta}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* Kitchen needs — quiet bullet list */}
    <section class="border-t border-gold/15 py-24">
      <div class="container mx-auto max-w-[760px]">
        <h2 class="text-center font-display text-[clamp(1.75rem,3.5vw,2.75rem)] tracking-[0.04em] text-sand">
          What the kitchen
          <em class="block font-serif italic font-normal text-gold-light">needs to provide</em>
        </h2>
        <ul class="mx-auto mt-10 grid max-w-[600px] gap-4">
          {kitchenNeeds.map((k) => (
            <li class="flex items-start gap-3 text-[16px] leading-[1.7] text-sand">
              <span aria-hidden="true" class="mt-2.5 inline-block size-1.5 shrink-0 rotate-45 bg-ember"></span>
              <span>{k}</span>
            </li>
          ))}
        </ul>
        <p class="mx-auto mt-8 max-w-[600px] text-center font-serif text-[16px] italic leading-[1.65] text-gold-light">
          When you're screening a villa, message the host: “We're bringing a private chef. Is the kitchen
          full-service, and is there outdoor or indoor dining for [headcount]?” If the answer hesitates, pick
          a different villa.
        </p>
      </div>
    </section>

    {/* Booking — 4 numbered steps, narrow column, no card chrome */}
    <section class="border-t border-gold/15 py-24">
      <div class="container mx-auto max-w-[760px]">
        <h2 class="text-center font-display text-[clamp(1.75rem,3.5vw,2.75rem)] tracking-[0.04em] text-sand">
          From WhatsApp
          <em class="block font-serif italic font-normal text-gold-light">to first course — 4 steps</em>
        </h2>
        <ol class="mt-12 grid gap-8">
          {steps.map((s) => (
            <li class="grid gap-4 sm:grid-cols-[80px_1fr] sm:gap-8">
              <span class="font-display text-[2.5rem] leading-none tracking-[0.04em] text-ember">{s.n}</span>
              <div>
                <h3 class="font-display text-[1.5rem] tracking-[0.04em] text-sand">{s.title}</h3>
                <p class="mt-2 text-[16px] leading-[1.7] text-sand-muted">{s.body}</p>
              </div>
            </li>
          ))}
        </ol>
        <p class="mt-12 text-center text-sand-muted">
          For pricing details, see our
          <a href="/private-chef-cost-marrakech/" class="text-ember-light hover:text-gold-light underline-offset-4 hover:underline">full pricing breakdown</a>.
          Wedding briefs go on the
          <a href="/services/wedding-dinner-marrakech/" class="text-ember-light hover:text-gold-light underline-offset-4 hover:underline">wedding chef page</a>.
        </p>
      </div>
    </section>

    {/* Riad vs villa — single sentence comparison, centered */}
    <section class="border-t border-gold/15 py-24">
      <div class="container mx-auto max-w-[760px] text-center">
        <p class="font-mono text-[11px] uppercase tracking-[0.32em] text-gold-light">Riad vs villa</p>
        <p class="mt-6 font-serif text-[clamp(1.25rem,2.5vw,1.75rem)] italic leading-[1.55] text-sand">
          “Riads win on atmosphere — tile work, courtyards, the call to prayer at sunset. Villas win on group
          size, pool, kitchen, garden. Most repeat guests do both.”
        </p>
      </div>
    </section>

    {/* FAQ */}
    <section class="border-t border-gold/15 py-24">
      <div class="container mx-auto max-w-[760px]">
        <h2 class="text-center font-display text-[clamp(1.75rem,3.5vw,2.75rem)] tracking-[0.04em] text-sand">FAQ</h2>
        <div class="mt-10 grid gap-0">
          {faqs.map((f) => (
            <details class="group border-b border-gold/15 py-5">
              <summary class="flex cursor-pointer items-center justify-between gap-4 font-serif text-[18px] text-sand list-none [&::-webkit-details-marker]:hidden">
                <span>{f.q}</span>
                <span aria-hidden="true" class="font-display text-2xl text-ember transition group-open:rotate-45">+</span>
              </summary>
              <p class="mt-3 leading-[1.75] text-sand-muted">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    {/* CTA */}
    <section class="border-t border-gold/15 py-24">
      <div class="container mx-auto max-w-[700px] text-center">
        <span class="inline-flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.32em] text-gold-light">
          <span aria-hidden="true" class="inline-block size-1.5 rotate-45 bg-ember"></span>
          Bring us to your villa
        </span>
        <h2 class="mt-6 font-display text-[clamp(2.25rem,4.5vw,3.5rem)] leading-[1] tracking-[0.04em] text-sand">
          Book the chef.
          <em class="mt-2 block font-serif italic font-normal text-[0.55em] text-gold-light">Keep the villa.</em>
        </h2>
        <p class="mt-5 text-sand-muted">Tell us the dates and the address — we'll send a draft menu inside 24 hours.</p>
        <a
          data-event="whatsapp_click" data-location="villa-guide"
          href="https://wa.me/212721354757?text=Hi%20%E2%80%94%20we%27ve%20rented%20a%20villa%20in%20Marrakech%20and%20would%20like%20a%20private%20chef.%20Address%3A%20%5B%5D%2C%20Date%3A%20%5B%5D%2C%20Guests%3A%20%5B%5D"
          target="_blank" rel="noopener noreferrer"
          class="mt-8 inline-flex items-center gap-3 rounded-full bg-ember px-8 py-4 font-mono text-[12px] uppercase tracking-[0.22em] text-white transition hover:-translate-y-px hover:bg-ember-light"
        >
          WhatsApp the chef
          <span aria-hidden="true" class="inline-block size-2 rotate-45 bg-white"></span>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
