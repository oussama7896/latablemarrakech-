---
// Short pricing landing — points at /private-chef-cost-marrakech/ for the
// detailed breakdown but keeps the /pricing/ URL alive for backwards-compat
// links. Same SEO contract as the live page (separate canonical).
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://latablemarrakech.com/' },
    { '@type': 'ListItem', position: 2, name: 'Pricing', item: 'https://latablemarrakech.com/pricing/' },
  ],
};

const included = [
  'Menu planning and consultation',
  'Fresh market shopping',
  'Multi-course preparation, serving and cleanup',
  'Dietary accommodations',
];

const faqs = [
  { q: 'Do you charge per person?', a: 'Yes — base pricing is €85 per person, all-inclusive. Larger groups (20+) move to a custom event tier with a fixed quote.' },
  { q: 'Are ingredients included?', a: 'Yes — fresh souk ingredients are included up to a generous food budget. Premium produce (truffle, lobster) is quoted separately.' },
];
---

<Layout
  title="Private Chef Pricing in Marrakech | La Table Marrakech"
  description="Private chef pricing in Marrakech — from €85 per person, all-inclusive. Minimum 2 guests. Wedding event packages from €1,200 for 20 guests."
  canonical="https://latablemarrakech.com/pricing/"
  htmlLang="en"
  hreflang={[
    { hreflang: 'en', href: 'https://latablemarrakech.com/pricing/' },
    { hreflang: 'fr', href: 'https://latablemarrakech.com/fr/pricing/' },
    { hreflang: 'ar', href: 'https://latablemarrakech.com/ar/pricing/' },
    { hreflang: 'x-default', href: 'https://latablemarrakech.com/pricing/' },
  ]}
  jsonLd={[breadcrumbLd]}
>
  <Nav lang="en" />

  <main>
    <header class="bg-ink-light pb-14 pt-20 sm:pt-24">
      <div class="container">
        <nav class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.22em] text-sand-muted" aria-label="Breadcrumb">
          <a href="/" class="hover:text-gold-light">Home</a>
          <span aria-hidden="true" class="text-ember">◆</span>
          <span class="text-gold-light">Pricing</span>
        </nav>
        <span class="eyebrow mt-8 inline-flex items-center gap-3"><span class="inline-block size-1.5 rotate-45 bg-ember"></span>From €85 per person</span>
        <h1 class="mt-6 font-display text-[clamp(2.5rem,5.5vw,4.5rem)] leading-[0.95] tracking-[0.04em] text-sand">
          Private chef pricing
          <em class="mt-2 block font-serif italic font-normal text-[0.55em] text-gold-light">in Marrakech.</em>
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-sand">
          From €85 per person, minimum 2 guests. Prices vary by menu, ingredients and service style.
        </p>
      </div>
    </header>

    <section class="bg-ink py-20">
      <div class="container max-w-[760px] space-y-10">
        <div>
          <h2 class="font-display text-[clamp(1.5rem,3vw,2.25rem)] tracking-[0.04em] text-sand">What's included</h2>
          <ul class="mt-4 grid gap-3 leading-relaxed text-sand">
            {included.map((i) => (
              <li class="border-l-2 border-ember/40 pl-4">{i}</li>
            ))}
          </ul>
        </div>

        <div>
          <h2 class="font-display text-[clamp(1.5rem,3vw,2.25rem)] tracking-[0.04em] text-sand">Pricing FAQ</h2>
          <div class="mt-4 grid gap-0">
            {faqs.map((f) => (
              <details class="group border-b border-gold/20 py-5">
                <summary class="flex cursor-pointer items-center justify-between gap-4 font-serif text-[18px] text-sand list-none [&::-webkit-details-marker]:hidden">
                  <span>{f.q}</span>
                  <span aria-hidden="true" class="font-display text-2xl text-ember transition group-open:rotate-45">+</span>
                </summary>
                <p class="mt-3 leading-[1.75] text-sand-muted">{f.a}</p>
              </details>
            ))}
          </div>
        </div>

        <p class="text-sand-muted">
          For the detailed cost breakdown, group-size pricing, and "What's not included":
          <a href="/private-chef-cost-marrakech/" class="text-ember-light hover:text-gold-light underline-offset-4 hover:underline">read the full pricing page</a>.
        </p>

        <div class="pt-4">
          <a
            data-event="whatsapp_click" data-location="pricing-old"
            href="https://wa.me/212721354757?text=I%27d%20like%20a%20chef%20quote"
            target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center gap-3 bg-ember px-8 py-4 font-mono text-[12px] uppercase tracking-[0.22em] text-white transition hover:-translate-y-px hover:bg-ember-light"
          >
            Get a custom quote
            <span aria-hidden="true" class="inline-block size-2 rotate-45 bg-white"></span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
