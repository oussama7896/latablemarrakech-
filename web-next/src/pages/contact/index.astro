---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import { ContactForm } from '@/components/ContactForm';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://latablemarrakech.com/' },
    { '@type': 'ListItem', position: 2, name: 'Contact', item: 'https://latablemarrakech.com/contact/' },
  ],
};

const contactPageLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact La Table Marrakech',
  url: 'https://latablemarrakech.com/contact/',
  description: 'Contact La Table Marrakech to book a private chef. WhatsApp, email, or inquiry form.',
  mainEntity: {
    '@type': 'Organization',
    name: 'La Table Marrakech',
    url: 'https://latablemarrakech.com/',
    telephone: '+212721354757',
    email: 'hello@latablemarrakech.com',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Derb Jdid 14',
      addressLocality: 'Marrakech',
      postalCode: '40000',
      addressCountry: 'MA',
    },
    contactPoint: [
      {
        '@type': 'ContactPoint', telephone: '+212721354757', contactType: 'Reservations',
        areaServed: ['MA', 'FR', 'GB', 'US', 'DE', 'AE'],
        availableLanguage: ['English', 'French', 'Arabic'],
      },
      {
        '@type': 'ContactPoint', email: 'hello@latablemarrakech.com', contactType: 'Customer Support',
        availableLanguage: ['English', 'French', 'Arabic'],
      },
    ],
  },
};

const contactCards = [
  {
    label: '◆ WhatsApp',
    title: 'Fastest',
    body: 'Direct line to the chef. Reply usually inside an hour during Moroccan working hours, up to 12 hours overnight.',
    cta: { href: 'https://wa.me/212721354757', text: '+212 721 354 757', tracked: true },
  },
  {
    label: '◆ Email',
    title: 'If you prefer it written',
    body: 'For longer briefs, corporate inquiries, press, or attachments. Reply within 24 hours, weekdays.',
    cta: { href: 'mailto:hello@latablemarrakech.com', text: 'hello@latablemarrakech.com', tracked: false },
  },
  {
    label: '◆ Form',
    title: 'Sends to WhatsApp',
    body: 'Fill the form below from your laptop — it opens WhatsApp pre-filled with your brief. Same response time as a direct WA message.',
    cta: { href: '#form', text: 'Jump to the form ↓', tracked: false },
  },
];

const cookAreas = [
  { place: 'Marrakech proper', detail: 'Palmeraie, Hivernage, Gueliz, Agdal, the medina. No transport charge.' },
  { place: 'Atlas valleys', detail: 'Ourika, Ouirgane, Imlil. Flat €20–40 transport add-on.' },
  { place: 'Agafay desert', detail: 'For sunset and overnight camp dinners. Flat €60 per person transport.' },
  { place: 'Essaouira / Atlantic coast', detail: 'On request, for events of 10+ guests.' },
];
---

<Layout
  title="Contact — Book a Private Chef in Marrakech | La Table Marrakech"
  description="Book a private chef in Marrakech via WhatsApp, email, or contact form. Confirmed within 24 hours. From €85 per person, 72-hour notice required."
  twitterDescription="WhatsApp, email, or inquiry form. Reply inside an hour."
  canonical="https://latablemarrakech.com/contact/"
  ogLocale="en_US"
  ogLocaleAlternates={["fr_FR", "ar_MA"]}
  htmlLang="en"
  hreflang={[
    { hreflang: 'en', href: 'https://latablemarrakech.com/contact/' },
    { hreflang: 'fr', href: 'https://latablemarrakech.com/fr/contact/' },
    { hreflang: 'ar', href: 'https://latablemarrakech.com/ar/contact/' },
    { hreflang: 'x-default', href: 'https://latablemarrakech.com/contact/' },
  ]}
  jsonLd={[breadcrumbLd, contactPageLd]}
>
  <Nav lang="en" />

  <main>
    {/* Page header */}
    <header class="bg-ink-light pb-16 pt-20 sm:pt-24">
      <div class="container">
        <nav class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.22em] text-sand-muted" aria-label="Breadcrumb">
          <a href="/" class="transition hover:text-gold-light">Home</a>
          <span aria-hidden="true" class="text-ember">◆</span>
          <span class="text-gold-light">Contact</span>
        </nav>
        <span class="eyebrow mt-8 inline-flex items-center gap-3">
          <span class="inline-block size-1.5 rotate-45 bg-ember"></span>
          Reply usually inside an hour
        </span>
        <h1 class="mt-6 font-display text-[clamp(2.75rem,6vw,5rem)] leading-[0.95] tracking-[0.04em] text-sand">
          Get in touch.
          <em class="mt-2 block font-serif italic font-normal text-[0.55em] text-gold-light">Three ways.</em>
        </h1>
        <p class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-[11px] uppercase tracking-[0.22em] text-sand-muted">
          <span>Halal · EN · FR · AR</span>
          <span>+212 721 354 757</span>
          <span>hello@latablemarrakech.com</span>
        </p>
      </div>
    </header>

    {/* Body */}
    <section class="bg-ink py-20">
      <div class="container max-w-3xl">
        <p class="text-lg leading-relaxed text-sand">
          Pick whichever is fastest for you. WhatsApp gets you a chef inside an hour. Email is fine
          if you prefer something written. The form below lands in the same WhatsApp inbox — useful
          if you're drafting from your laptop.
        </p>

        {/* 3-up contact cards */}
        <div class="mt-14 grid gap-4 md:grid-cols-3">
          {contactCards.map((c) => (
            <div class="flex flex-col gap-3 border border-gold/20 border-t-[3px] border-t-ember bg-ink-light p-7">
              <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-gold">{c.label}</span>
              <h3 class="font-serif text-[20px] italic text-sand">{c.title}</h3>
              <p class="text-sm leading-relaxed text-sand-muted">{c.body}</p>
              {c.cta.tracked ? (
                <a
                  data-event="whatsapp_click"
                  data-location="contact"
                  href={c.cta.href}
                  rel="noopener noreferrer"
                  target="_blank"
                  class="mt-2 font-mono text-sm tracking-wide text-ember-light hover:text-gold-light"
                >
                  {c.cta.text}
                </a>
              ) : (
                <a
                  href={c.cta.href}
                  class="mt-2 font-mono text-sm tracking-wide text-ember-light hover:text-gold-light"
                >
                  {c.cta.text}
                </a>
              )}
            </div>
          ))}
        </div>

        {/* Where we cook */}
        <h2 class="mt-20 font-display text-[clamp(1.75rem,3.5vw,2.75rem)] leading-tight tracking-[0.04em] text-sand">
          Where we <em class="font-serif italic font-normal text-gold-light">cook</em>
        </h2>
        <p class="mt-3 text-sand-muted">We're based in the Marrakech medina. We work across the city and out to:</p>
        <ul class="mt-6 grid gap-3">
          {cookAreas.map((a) => (
            <li class="flex flex-col gap-1 border-l-2 border-ember/40 bg-ink-light/50 px-5 py-3">
              <strong class="font-serif text-base text-sand">{a.place}</strong>
              <span class="text-sm text-sand-muted">{a.detail}</span>
            </li>
          ))}
        </ul>

        {/* Hours */}
        <h2 class="mt-16 font-display text-[clamp(1.75rem,3.5vw,2.75rem)] leading-tight tracking-[0.04em] text-sand">
          Hours &amp; <em class="font-serif italic font-normal text-gold-light">response time</em>
        </h2>
        <p class="mt-3 text-sand-muted">
          The chef takes bookings every day. Service nights happen any night of the week (Friday royal couscous
          nights are popular — book those further ahead). WhatsApp replies typically within an hour during
          9am–9pm Morocco time (GMT+1), longer at night.
        </p>
        <p class="mt-3 text-sand-muted">
          Last-minute bookings under 48 hours:
          <a
            data-event="whatsapp_click"
            data-location="contact"
            href="https://wa.me/212721354757"
            rel="noopener noreferrer"
            target="_blank"
            class="text-ember-light hover:text-gold-light"
          >message us</a> with the date and we'll let you know if a chef is free that night.
        </p>

        {/* Inquiry form */}
        <h2 id="form" class="mt-20 font-display text-[clamp(1.75rem,3.5vw,2.75rem)] leading-tight tracking-[0.04em] text-sand">
          Inquiry <em class="font-serif italic font-normal text-gold-light">form</em>
        </h2>
        <p class="mt-3 text-sand-muted">
          This form opens WhatsApp pre-filled with your brief. Replies come back on WhatsApp.
        </p>

        <div class="mt-8 border border-gold/20 border-l-[4px] border-l-ember bg-ink-light p-7 sm:p-9">
          <ContactForm client:load />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
