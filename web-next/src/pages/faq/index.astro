---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import sections from '@/data/faq-page.json';

type FaqItem = { q: string; a: string; linkHref?: string; linkText?: string };
type FaqSection = { section: string; items: FaqItem[] };

// FAQPage JSON-LD — sourced from a richer copy than the on-page text so
// Google sees the longer canonical answers (matches the live page).
const faqLdEntries: Array<{ q: string; a: string }> = [
  { q: 'How much does a private chef cost in Marrakech?', a: 'From €85 per person at La Table Marrakech, all-inclusive (menu, souk shopping, cooking, service, cleanup). Minimum 2 guests. Wedding event packages start at €1,200 for 20 guests, separate from the per-person rate. Full pricing breakdown on the pricing page.' },
  { q: "What's included in the price?", a: "Everything: menu planning over WhatsApp, the chef's morning visit to the medina souk, all ingredients and cookware, cooking, plating and table service, mint-tea ceremony, and full kitchen cleanup. €85 per person, all-inclusive." },
  { q: "What's NOT included?", a: "Drinks, premium add-ons like live cooking stations, chef tip (10% is local norm but not required), and luxury produce that exceeds the standard food budget — fresh truffle, lobster, A5 wagyu — quoted separately if you ask." },
  { q: 'How far in advance should I book?', a: '72 hours is ideal. For peak season (October–April) or groups over 10, book 1–2 weeks ahead. Last-minute bookings under 48 hours are regularly possible — message us on WhatsApp to check availability.' },
  { q: 'How many guests can the chef serve?', a: 'From 2 to 30+. Minimum 2 guests per booking. €85 per person up to 19 guests; for 20+ we move to the event tier (custom quote, full service brigade). For weddings of 50–200+, see the wedding page.' },
  { q: 'Is the food halal?', a: 'Halal by default. All meat is bought from certified halal butchers in the medina souk. Kosher, vegetarian and vegan menus run in parallel on request.' },
  { q: 'Can the chef accommodate dietary restrictions?', a: 'Yes. Vegetarian, vegan, gluten-free, kosher, halal, allergies, low-carb, dairy-free — flag at booking, no extra charge. Moroccan cuisine is naturally flexible. We share the menu in writing for you to approve.' },
  { q: 'What kind of food do you cook?', a: 'Traditional Moroccan cuisine: tagines (lamb, chicken, kefta, fish), pastilla (pigeon, chicken, or fish-with-spinach), royal couscous Friday, Moroccan salads (zaalouk, taktouka, the seven salads), mechoui lamb, and traditional desserts and mint tea. Mediterranean and French influences possible on request.' },
  { q: 'Do I need a kitchen?', a: 'Yes — a working oven, gas hob (4 burners ideal), a sink with hot water, and a fridge with at least one shelf empty. We bring all cookware, knives, charcoal, and serving plates if needed.' },
  { q: 'Can the chef cook at a riad in the medina?', a: 'Yes. We work at riads regularly. Riad kitchens are smaller but the souk is 50 metres away. Service usually moves to the courtyard or rooftop. Maximum 12–14 guests realistically.' },
  { q: 'Can the chef cook in the desert?', a: 'Yes — Agafay desert camps are a regular venue. We bring everything; cooking is over charcoal or wood fire. A flat €60 per person transport add-on for desert dinners.' },
  { q: 'How do I pay?', a: '50% deposit on confirmation, balance on the night. Stripe, wire transfer (EUR or USD), Apple Pay, Visa/Mastercard, or local cash in MAD. Corporate bookings invoiced with VAT-compliant documentation; net-30 terms for repeat clients.' },
  { q: 'Can you cater a wedding?', a: 'Yes. Wedding bookings start at €1,200 for 20 guests, scaling to celebrations of 200+. Full service brigade, table styling, mint-tea ceremony and cleanup included. Book 4–8 weeks in advance for peak season — see the wedding chef page for details.' },
  { q: 'Can you cater a corporate dinner or offsite?', a: 'Yes. Corporate dinners start at €650 for 10 guests with full service. Multilingual team (English, French, Arabic by default; Spanish, German, Italian on request). Invoiced in EUR or USD with VAT-compliant docs. NDAs available.' },
  { q: 'Do you offer cooking classes?', a: 'Yes — as an add-on to the chef dinner, at your villa or riad. €200 for up to 6 guests, hands-on, you cook one of our signature menus with us, then we eat together.' },
  { q: "What's the cancellation policy?", a: 'More than 7 days out: 50% deposit refunded. 2–7 days: deposit non-refundable but credited to a future booking. Under 48 hours: non-refundable. Force majeure (illness, flight cancellation) handled case by case.' },
  { q: "What if the menu I want isn't on the standard list?", a: "Tell us. We work from what's at the souk that morning, not a fixed menu. If you want a specific tagine, a non-Moroccan course, a kid-friendly section, or a fully bespoke tasting menu — flag it in the brief and we'll cost it for you." },
];

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://latablemarrakech.com/' },
    { '@type': 'ListItem', position: 2, name: 'FAQ', item: 'https://latablemarrakech.com/faq/' },
  ],
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqLdEntries.map((f) => ({
    '@type': 'Question', name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const totalQuestions = (sections as FaqSection[]).reduce((n, s) => n + s.items.length, 0);
---

<Layout
  title="FAQ — Private Chef in Marrakech | La Table Marrakech"
  description="Private chef in Marrakech — booking, pricing, dietary restrictions, group sizes, cancellation policy. All your questions answered. From €85 per person."
  twitterTitle="FAQ — La Table Marrakech"
  twitterDescription="The most-asked questions about hiring a private chef in Marrakech."
  canonical="https://latablemarrakech.com/faq/"
  ogLocale="en_US"
  htmlLang="en"
  hreflang={[
    { hreflang: 'en', href: 'https://latablemarrakech.com/faq/' },
    { hreflang: 'x-default', href: 'https://latablemarrakech.com/faq/' },
  ]}
  jsonLd={[breadcrumbLd, faqLd]}
>
  <Nav lang="en" />

  <main>
    {/* Hero */}
    <header class="bg-ink-light pb-16 pt-20 sm:pt-24">
      <div class="container">
        <nav class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.22em] text-sand-muted" aria-label="Breadcrumb">
          <a href="/" class="transition hover:text-gold-light">Home</a>
          <span aria-hidden="true" class="text-ember">◆</span>
          <span class="text-gold-light">FAQ</span>
        </nav>
        <span class="eyebrow mt-8 inline-flex items-center gap-3">
          <span class="inline-block size-1.5 rotate-45 bg-ember"></span>
          {totalQuestions} questions, honest answers
        </span>
        <h1 class="mt-6 font-display text-[clamp(2.75rem,6vw,5rem)] leading-[0.95] tracking-[0.04em] text-sand">
          Asked at every
          <em class="mt-2 block font-serif italic font-normal text-[0.55em] text-gold-light">first call.</em>
        </h1>
        <p class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-[11px] uppercase tracking-[0.22em] text-sand-muted">
          <span>Updated 2026-04</span>
          <span>{totalQuestions} questions</span>
        </p>
      </div>
    </header>

    {/* Article body */}
    <section class="bg-ink py-20">
      <article class="container max-w-[760px]">
        <p class="text-lg leading-relaxed text-sand">
          The {totalQuestions} questions we get most often. If yours isn't here,
          <a
            data-event="whatsapp_click"
            data-location="faq"
            href="https://wa.me/212721354757"
            target="_blank"
            rel="noopener noreferrer"
            class="text-ember-light underline-offset-4 hover:text-gold-light hover:underline"
          >message us on WhatsApp</a> — we usually answer in under an hour.
        </p>

        <div class="my-12 flex justify-center" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 14 14" class="text-ember">
            <polygon points="7,0 14,7 7,14 0,7" fill="currentColor" opacity="0.3" />
            <polygon points="7,3 11,7 7,11 3,7" fill="currentColor" />
          </svg>
        </div>

        {(sections as FaqSection[]).map((sec) => (
          <section class="mt-12 first:mt-0">
            <h2 class="font-display text-[clamp(1.5rem,3vw,2.25rem)] leading-snug tracking-[0.04em] text-sand">
              <em class="font-serif italic font-normal text-gold-light">{sec.section}</em>
            </h2>
            <div class="mt-4 grid gap-0">
              {sec.items.map((f) => (
                <details class="group border-b border-gold/20 py-5">
                  <summary class="flex cursor-pointer items-center justify-between gap-4 font-serif text-[18px] text-sand list-none [&::-webkit-details-marker]:hidden">
                    <span>{f.q}</span>
                    <span aria-hidden="true" class="font-display text-2xl text-ember transition group-open:rotate-45">+</span>
                  </summary>
                  <p class="mt-3 leading-[1.75] text-sand-muted">
                    <span set:html={f.a} />
                    {f.linkHref && (
                      <>{' '}<a href={f.linkHref} class="text-ember-light underline-offset-4 hover:text-gold-light hover:underline">{f.linkText}</a></>
                    )}
                  </p>
                </details>
              ))}
            </div>
          </section>
        ))}
      </article>
    </section>

    {/* CTA band */}
    <section class="border-t border-gold/15 bg-ink-light py-20">
      <div class="container max-w-[700px] text-center">
        <span class="eyebrow inline-flex items-center gap-3">
          <span class="inline-block size-1.5 rotate-45 bg-ember"></span>
          Question not here?
        </span>
        <h2 class="mt-6 font-display text-[clamp(2.25rem,4.5vw,3.5rem)] leading-[1] tracking-[0.04em] text-sand">
          Just ask.
          <em class="mt-2 block font-serif italic font-normal text-[0.55em] text-gold-light">Reply in under an hour.</em>
        </h2>
        <p class="mt-5 text-sand-muted">
          The chef takes WhatsApp messages directly. Tell us the date, the headcount, and what you're trying to do.
        </p>
        <a
          data-event="whatsapp_click"
          data-location="faq"
          href="https://wa.me/212721354757"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-flex items-center gap-3 bg-ember px-8 py-4 font-mono text-[12px] uppercase tracking-[0.22em] text-white transition hover:-translate-y-px hover:bg-ember-light"
        >
          WhatsApp the chef
          <span aria-hidden="true" class="inline-block size-2 rotate-45 bg-white"></span>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
