---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';

const url = 'https://latablemarrakech.com/marrakech-cooking-class-vs-private-chef/';
const breadcrumbLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://latablemarrakech.com/' },
  { '@type': 'ListItem', position: 2, name: 'Class vs Chef', item: url },
]};
const articleLd = { '@context': 'https://schema.org', '@type': 'Article',
  headline: 'Marrakech Cooking Class vs Private Chef: Which Should You Book?',
  description: 'Comparing Marrakech cooking classes ($45–90 pp) with hiring a private chef (from €85 per person). Pros, cons, and which fits your trip — written by Marrakech chefs.',
  image: 'https://latablemarrakech.com/la-table-marrakech-og.png',
  datePublished: '2026-04-27T08:00:00+01:00', dateModified: '2026-04-27T08:00:00+01:00',
  author: { '@type': 'Organization', name: 'La Table Marrakech', url: 'https://latablemarrakech.com/' },
  publisher: { '@type': 'Organization', name: 'La Table Marrakech', logo: { '@type': 'ImageObject', url: 'https://latablemarrakech.com/la-table-marrakech-og.png' } },
  mainEntityOfPage: url,
};

const compare = [
  ['Format', 'Hands-on, you cook', 'Sit down, chef cooks'],
  ['Duration', '3–5 hours including souk visit', '4–6 hours total, you only see service'],
  ['Group size', '2–8 typical', '2–30+ guests'],
  ['Where', 'Riad / cooking school kitchen', 'At your villa or riad'],
  ['Effort from you', 'Active — you chop, stir, plate', 'None — be the guest at your table'],
  ['Take-home', 'Recipes + the meal you cooked', 'Memory + spotless kitchen'],
  ['Price', '$45–90 per person', 'From €85 per person, all-in'],
  ['Best for', 'Curious cooks, day-trippers', 'Anniversaries, families, villa stays'],
];
---

<Layout
  title="Marrakech Cooking Class vs Private Chef: Which Should You Book? | La Table"
  description="Comparing Marrakech cooking classes ($45-90 pp) with hiring a private chef (from €85 per person). Pros, cons, and which fits your trip — written by Marrakech chefs, not a booking site."
  canonical={url}
  htmlLang="en"
  hreflang={[
    { hreflang: 'en', href: url },
    { hreflang: 'fr', href: 'https://latablemarrakech.com/fr/cours-de-cuisine-marrakech/' },
    { hreflang: 'x-default', href: url },
  ]}
  jsonLd={[breadcrumbLd, articleLd]}
>
  <Nav lang="en" />

  <main>
    <header class="bg-ink-light pb-14 pt-24">
      <div class="container max-w-[920px]">
        <nav class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.22em] text-sand-muted" aria-label="Breadcrumb">
          <a href="/" class="hover:text-gold-light">Home</a>
          <span aria-hidden="true" class="text-ember">◆</span>
          <span class="text-gold-light">Class vs Chef</span>
        </nav>
        <span class="eyebrow mt-8 inline-flex items-center gap-3"><span class="inline-block size-1.5 rotate-45 bg-ember"></span>Honest comparison</span>
        <h1 class="mt-6 font-display text-[clamp(2.5rem,6vw,4.75rem)] leading-[1] tracking-[0.04em] text-sand">
          Marrakech cooking class
          <em class="mt-3 block font-serif italic font-normal text-[0.55em] text-gold-light">or private chef dinner?</em>
        </h1>
        <p class="mt-7 max-w-2xl text-lg leading-relaxed text-sand">
          We do both. Here's the honest comparison so you can pick what fits your trip — without being sold.
        </p>
      </div>
    </header>

    <section class="bg-ink py-20">
      <article class="container max-w-[820px] space-y-12">
        <div>
          <h2 class="font-display text-[clamp(1.5rem,3vw,2.25rem)] tracking-[0.04em] text-sand">The short answer</h2>
          <p class="mt-4 leading-[1.75] text-sand"><strong class="text-sand">Cooking class</strong> if you want a hands-on day-trip experience and to take recipes home. <strong class="text-sand">Private chef dinner</strong> if you want a celebration meal in your villa with zero effort. Many guests do both — class on day 2, chef dinner on day 4.</p>
        </div>

        <div>
          <h2 class="font-display text-[clamp(1.5rem,3vw,2.25rem)] tracking-[0.04em] text-sand">Side-by-side comparison</h2>
          <div class="mt-6 overflow-x-auto">
            <table class="w-full border-collapse text-[14px]">
              <thead>
                <tr class="border-b border-gold/30 text-left font-mono text-[10px] uppercase tracking-[0.22em] text-gold">
                  <th class="py-3 pr-4">&nbsp;</th>
                  <th class="py-3 pr-4">Cooking class</th>
                  <th class="py-3">Private chef</th>
                </tr>
              </thead>
              <tbody class="text-sand">
                {compare.map(([k, c, ch]) => (
                  <tr class="border-b border-gold/15">
                    <td class="py-3 pr-4 font-mono text-[11px] uppercase tracking-[0.18em] text-sand-muted">{k}</td>
                    <td class="py-3 pr-4">{c}</td>
                    <td class="py-3">{ch}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <div>
          <h2 class="font-display text-[clamp(1.5rem,3vw,2.25rem)] tracking-[0.04em] text-sand">What a class is actually like</h2>
          <p class="mt-4 leading-[1.75] text-sand">A morning souk walk (1 hour), then 2–3 hours in a riad kitchen rolling pastilla, mixing tagine spice, plating a meal you cooked together. You eat what you make, around 1pm. Recipes go home with you.</p>
        </div>

        <div>
          <h2 class="font-display text-[clamp(1.5rem,3vw,2.25rem)] tracking-[0.04em] text-sand">What a chef dinner is actually like</h2>
          <p class="mt-4 leading-[1.75] text-sand">Chef walks the souk at dawn. Arrives at your villa at 4–5pm with knives, tagines, charcoal. Cooks for 4 hours. Serves five courses paced through the evening. By 11pm, kitchen is spotless and chef is gone. You did nothing but eat.</p>
        </div>

        <div>
          <h2 class="font-display text-[clamp(1.5rem,3vw,2.25rem)] tracking-[0.04em] text-sand">Decision tree</h2>
          <ul class="mt-4 grid gap-3 leading-relaxed text-sand">
            <li class="border-l-2 border-ember/40 pl-4"><strong class="text-sand">Day-trip in Marrakech?</strong> Class.</li>
            <li class="border-l-2 border-ember/40 pl-4"><strong class="text-sand">Anniversary, birthday, family stay?</strong> Chef.</li>
            <li class="border-l-2 border-ember/40 pl-4"><strong class="text-sand">Curious cook + want recipes?</strong> Class.</li>
            <li class="border-l-2 border-ember/40 pl-4"><strong class="text-sand">Villa for 6+ guests?</strong> Chef. Maths work better.</li>
            <li class="border-l-2 border-ember/40 pl-4"><strong class="text-sand">Want both?</strong> Book a class with us as an add-on to a chef night — €200 for up to 6 guests.</li>
          </ul>
        </div>

        <div>
          <h2 class="font-display text-[clamp(1.5rem,3vw,2.25rem)] tracking-[0.04em] text-sand">The case for doing both</h2>
          <p class="mt-4 leading-[1.75] text-sand">Class teaches you the technique; the chef dinner shows you what mastery looks like. They're not competing products — they're complementary. The repeat guests we cook for almost all do one of each across a 5-night trip.</p>
        </div>

        <div>
          <h2 class="font-display text-[clamp(1.5rem,3vw,2.25rem)] tracking-[0.04em] text-sand">Pricing at a glance</h2>
          <p class="mt-4 leading-[1.75] text-sand">Cooking class: <strong class="text-sand">$45–90 per person</strong> (most operators). Private chef dinner: <strong class="text-sand">€85 per person, all-in</strong> at La Table Marrakech. <a href="/private-chef-cost-marrakech/" class="text-ember-light hover:text-gold-light underline-offset-4 hover:underline">Full chef pricing breakdown</a>.</p>
        </div>
      </article>
    </section>

    <section class="border-t border-gold/15 bg-ink-light py-20">
      <div class="container max-w-[700px] text-center">
        <h2 class="font-display text-[clamp(2rem,4vw,3rem)] leading-[1] tracking-[0.04em] text-sand">
          Skip the class today.
          <em class="mt-2 block font-serif italic font-normal text-[0.6em] text-gold-light">Eat like royalty tonight.</em>
        </h2>
        <p class="mt-5 text-sand-muted">From €85 per person, all-in. Confirmed in 24 hours via WhatsApp.</p>
        <a
          data-event="whatsapp_click" data-location="class-vs-chef"
          href="https://wa.me/212721354757?text=Hi%20%E2%80%94%20I%27d%20like%20a%20chef%20dinner"
          target="_blank" rel="noopener noreferrer"
          class="mt-8 inline-flex items-center gap-3 bg-ember px-8 py-4 font-mono text-[12px] uppercase tracking-[0.22em] text-white transition hover:-translate-y-px hover:bg-ember-light"
        >
          WhatsApp the chef
          <span aria-hidden="true" class="inline-block size-2 rotate-45 bg-white"></span>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
