---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';

const sections = [
  { title: 'Qui nous sommes', body: 'La Table Marrakech est un service de chef privé à Marrakech. Contact : <a href="mailto:hello@latablemarrakech.com" class="text-ember-light hover:text-gold-light underline-offset-4 hover:underline">hello@latablemarrakech.com</a>.' },
  { title: 'Données collectées', body: 'Lors d\'une demande de réservation : nom, email, date, heure, nombre d\'invités, notes. Les données sont transmises directement à notre numéro WhatsApp pour traiter la réservation.' },
  { title: 'Utilisation', body: 'Uniquement pour répondre à votre demande, confirmer la réservation, coordonner le service, et faire le suivi. Aucune vente ni partage à des fins marketing.' },
  { title: 'Cookies', body: 'Cookies minimaux. Google Analytics 4 et Google Ads conversion tracking, activés uniquement après votre consentement via la bannière cookies.' },
  { title: 'Tiers', body: 'Données transmises via WhatsApp (Meta). Polices via Google Fonts. Aucune donnée vendue à des tiers.' },
  { title: 'Vos droits', body: 'Droit d\'accès, de rectification et de suppression. Contactez-nous à <a href="mailto:hello@latablemarrakech.com" class="text-ember-light hover:text-gold-light underline-offset-4 hover:underline">hello@latablemarrakech.com</a>.' },
  { title: 'Conservation', body: 'Les communications de réservation sont conservées 12 mois maximum, puis supprimées.' },
];
---

<Layout
  title="Politique de Confidentialité | La Table Marrakech"
  description="Politique de confidentialité de La Table Marrakech — comment nous collectons, utilisons et protégeons vos données personnelles."
  canonical="https://latablemarrakech.com/fr/privacy/"
  htmlLang="fr"
  ogLocale="fr_FR"
  robots="noindex, follow"
  hreflang={[
    { hreflang: 'en', href: 'https://latablemarrakech.com/privacy/' },
    { hreflang: 'fr', href: 'https://latablemarrakech.com/fr/privacy/' },
    { hreflang: 'ar', href: 'https://latablemarrakech.com/ar/privacy/' },
    { hreflang: 'x-default', href: 'https://latablemarrakech.com/privacy/' },
  ]}
>
  <Nav lang="fr" />

  <main>
    <header class="bg-ink-light pb-14 pt-24">
      <div class="container">
        <h1 class="font-display text-[clamp(2.5rem,5.5vw,4.5rem)] leading-[0.95] tracking-[0.04em] text-sand">
          Politique de <em class="font-serif italic font-normal text-gold-light">confidentialité</em>
        </h1>
        <p class="mt-4 font-mono text-[11px] uppercase tracking-[0.22em] text-sand-muted">
          Dernière mise à jour : avril 2026
        </p>
      </div>
    </header>

    <section class="bg-ink py-20">
      <article class="container max-w-[760px] space-y-10">
        {sections.map((s) => (
          <section>
            <h2 class="font-display text-[clamp(1.5rem,3vw,2.25rem)] tracking-[0.04em] text-sand">{s.title}</h2>
            <p class="mt-3 leading-[1.75] text-sand-muted" set:html={s.body} />
          </section>
        ))}
      </article>
    </section>
  </main>

  <Footer />
</Layout>
