---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Hero from '@/components/Hero.astro';
import TrustedBy from '@/components/TrustedBy.astro';
import About from '@/components/About.astro';
import Testimonials from '@/components/Testimonials.astro';
import FeaturedMenu from '@/components/FeaturedMenu.astro';
import WhyUs from '@/components/WhyUs.astro';
import HowTo from '@/components/HowTo.astro';
import BookingSection from '@/components/BookingSection.astro';
import Intermission from '@/components/Intermission.astro';
import Faq from '@/components/Faq.astro';
import Footer from '@/components/Footer.astro';
import { fr as t } from '@/data/home-i18n';

const localBusinessLd = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'FoodService'],
  name: 'La Table Marrakech',
  description: t.layout.description,
  url: 'https://latablemarrakech.com/fr/',
  inLanguage: 'fr',
  telephone: '+212721354757',
  email: 'hello@latablemarrakech.com',
  priceRange: '€€',
  currenciesAccepted: 'EUR, MAD, USD',
  paymentAccepted: 'Apple Pay, Stripe, PayPal, Visa, Mastercard',
  address: { '@type': 'PostalAddress', addressLocality: 'Marrakech', addressCountry: 'MA' },
  geo: { '@type': 'GeoCoordinates', latitude: 31.6295, longitude: -7.9811 },
  areaServed: { '@type': 'City', name: 'Marrakech' },
  logo: 'https://latablemarrakech.com/la-table-marrakech-og.png',
  image: 'https://latablemarrakech.com/private-chef-marrakech-tagine.webp',
  aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.9', reviewCount: '200', bestRating: '5' },
  offers: {
    '@type': 'Offer', priceCurrency: 'EUR', price: '85', priceValidUntil: '2026-12-31',
    availability: 'https://schema.org/InStock',
    description: 'Chef privé à partir de 85€ par personne — ingrédients frais du souk, multi-plats, service à table et nettoyage complet inclus. Minimum 2 convives.',
  },
  sameAs: ['https://wa.me/212721354757'],
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'fr',
  mainEntity: t.faq.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title={t.layout.title}
  description={t.layout.description}
  canonical="https://latablemarrakech.com/fr/"
  htmlLang="fr"
  ogLocale="fr_FR"
  ogLocaleAlternates={["en_US", "ar_MA"]}
  slateLang="fr"
  hreflang={[
    { hreflang: 'en', href: 'https://latablemarrakech.com/' },
    { hreflang: 'fr', href: 'https://latablemarrakech.com/fr/' },
    { hreflang: 'ar', href: 'https://latablemarrakech.com/ar/' },
    { hreflang: 'x-default', href: 'https://latablemarrakech.com/' },
  ]}
  jsonLd={[localBusinessLd, faqLd]}
  preloadImages={[
    { href: '/moroccan-feast-villa-terrace.webp', type: 'image/webp', fetchpriority: 'high' },
  ]}
>
  <Nav lang="fr" />

  <main>
    <Hero
      eyebrow={t.hero.eyebrow}
      titleLines={t.hero.titleLines}
      tagline={t.hero.tagline}
      slate={t.hero.slate}
      bottomTrust={t.hero.bottomTrust}
      cta={t.hero.cta}
      ghostCta={t.hero.ghostCta}
      scrollLabel={t.hero.scrollLabel}
    />

    <TrustedBy
      caption={t.trusted.caption}
      verifiedLabel={t.trusted.verifiedLabel}
      verified={t.trusted.verified}
    />

    <BookingSection
      eyebrow={t.booking.eyebrow}
      headHead={t.booking.headHead}
      headEm={t.booking.headEm}
      body={t.booking.body}
      trust={t.booking.trust}
      whatsapp={t.booking.whatsapp}
      formTitle={t.booking.formTitle}
      formMeta={t.booking.formMeta}
      noscriptLine={t.booking.noscriptLine}
      footerLine={t.booking.footerLine}
    />

    <Intermission
      image="/lt-rfissa-lanterns-mosaic.jpg"
      alt="Un tagine de rfissa fumant sur une table berbère sculptée, encadré de lanternes en cuivre et d'un mur de zellige"
      line={t.intermission.line}
      meta={t.intermission.meta}
    />

    <About
      eyebrow={t.about.eyebrow}
      titleHead={t.about.titleHead}
      titleEm={t.about.titleEm}
      paragraphs={t.about.paragraphs}
      pullQuote={t.about.pullQuote}
      pullQuoteAttribution={t.about.pullQuoteAttribution}
      signatureLine={t.about.signatureLine}
      ctaLabel={t.about.ctaLabel}
      frames={[
        { src: '/blue-tagine-moroccan-spices.webp', alt: '', caption: t.about.frames[0].caption, time: t.about.frames[0].time },
        { src: '/chef-cooking-marrakech-kitchen.webp', alt: '', caption: t.about.frames[1].caption, time: t.about.frames[1].time },
        { src: '/moroccan-feast-villa-terrace.webp', alt: '', caption: t.about.frames[2].caption, time: t.about.frames[2].time },
      ]}
    />

    <FeaturedMenu
      eyebrow={t.menu.eyebrow}
      titleHead={t.menu.titleHead}
      titleEm={t.menu.titleEm}
      intro={t.menu.intro}
      meta={t.menu.meta}
      fullMenuCta={t.menu.fullMenuCta}
      carteEyebrow={t.menu.carteEyebrow}
      carteSub={t.menu.carteSub}
      cartePlace={t.menu.cartePlace}
      showMore={t.menu.showMore}
      showLess={t.menu.showLess}
      chefQuote={t.menu.chefQuote}
      chefAttribution={t.menu.chefAttribution}
      courses={t.menu.courses}
      moreCourses={t.menu.moreCourses}
    />

    <Testimonials
      eyebrow={t.testimonials.eyebrow}
      rating={t.testimonials.rating}
      ratingLabel={t.testimonials.ratingLabel}
      headlineHead={t.testimonials.headlineHead}
      headlineEm={t.testimonials.headlineEm}
      sub={t.testimonials.sub}
      readAll={t.testimonials.readAll}
      heroDish={t.testimonials.heroDish}
      quotes={t.testimonials.quotes}
    />

    <WhyUs
      eyebrow={t.whyus.eyebrow}
      titleHead={t.whyus.titleHead}
      titleEm={t.whyus.titleEm}
      intro={t.whyus.intro}
      ctaLabel={t.whyus.ctaLabel}
      reasons={t.whyus.reasons}
    />

    <HowTo
      eyebrow={t.howto.eyebrow}
      titleHead={t.howto.titleHead}
      titleEm={t.howto.titleEm}
      titleTail={t.howto.titleTail}
      ctaLabel={t.howto.ctaLabel}
      steps={t.howto.steps}
    />

    <Faq
      eyebrow={t.faq.eyebrow}
      titleHead={t.faq.titleHead}
      titleEm={t.faq.titleEm}
      intro={t.faq.intro}
      whatsappCta={t.faq.whatsappCta}
      faqs={t.faq.faqs}
    />

    <section
      class="relative isolate overflow-hidden border-t border-gold/15 bg-ink py-24 sm:py-28"
      aria-label="La Table Marrakech"
    >
      <span
        aria-hidden="true"
        class="pointer-events-none absolute -top-32 left-1/2 h-[420px] w-[820px] -translate-x-1/2 rounded-full bg-ember/12 blur-3xl"
      ></span>
      <span aria-hidden="true" class="lt-hero-grain absolute inset-0 opacity-[0.08] mix-blend-overlay"></span>
      <div data-reveal class="container relative flex flex-col items-center gap-9 text-center">
        <span class="inline-flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.32em] text-gold-light">
          <span aria-hidden="true" class="inline-block size-1.5 rotate-45 bg-ember"></span>
          Le carton final
        </span>
        <img src="/lt-brand-titlecard.png" alt="La Table — Marrakech. Service de chef privé. Petit-déjeuner · Demi-pension · Pension complète · Événement privé." loading="lazy" decoding="async" class="lt-duotone-soft mx-auto w-full max-w-[1080px]" />
        <p class="max-w-[42ch] font-serif italic text-[17px] leading-[1.55] text-gold-light">
          Une table. Un chef. Une soirée que vous n&rsquo;oublierez pas.
        </p>
        <a href="#booking" class="group inline-flex items-center gap-3 rounded-full bg-ember px-10 py-[18px] font-mono text-[12px] uppercase tracking-[0.24em] text-white shadow-[0_18px_40px_-12px_rgba(184,79,46,0.55)] transition hover:-translate-y-px hover:bg-ember-light">
          Réservez votre dîner
          <span aria-hidden="true" class="inline-block size-2 rotate-45 bg-sand transition group-hover:translate-x-0.5"></span>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
