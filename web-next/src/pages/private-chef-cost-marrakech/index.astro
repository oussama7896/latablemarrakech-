---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://latablemarrakech.com/' },
    { '@type': 'ListItem', position: 2, name: 'Private Chef Cost Marrakech', item: 'https://latablemarrakech.com/private-chef-cost-marrakech/' },
  ],
};

const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: 'Private Chef Cost in Marrakech (2026): From €85 per person',
  description: "Transparent 2026 pricing for a private chef in Marrakech: €85 per person, all-inclusive. What you get, what's not included, and how it compares to fine dining.",
  image: 'https://latablemarrakech.com/la-table-marrakech-og.png',
  datePublished: '2026-04-27T08:00:00+01:00', dateModified: '2026-04-27T08:00:00+01:00',
  author: { '@type': 'Organization', name: 'La Table Marrakech', url: 'https://latablemarrakech.com/' },
  publisher: { '@type': 'Organization', name: 'La Table Marrakech', logo: { '@type': 'ImageObject', url: 'https://latablemarrakech.com/la-table-marrakech-og.png' } },
  mainEntityOfPage: 'https://latablemarrakech.com/private-chef-cost-marrakech/',
};

const faqs = [
  { q: 'Are taxes and service charges included in the €85 per person?', a: 'Yes. The €85 per person is the all-in number. No separate service charge, no minimum bar spend, no per-course add-on. Minimum 2 guests.' },
  { q: 'How much does a private chef cost for a wedding in Marrakech?', a: 'From €1,200 for 20 guests in our event tier (separate from the €85/pp standard rate), scaling per guest from there.', linkHref: '/services/wedding-dinner-marrakech/', linkText: 'Full wedding pricing here.' },
  { q: 'Do you charge extra for last-minute bookings?', a: 'No surcharge. Last-minute (under 48 hours) is regularly possible — message us on WhatsApp and we’ll let you know if a chef is free.' },
  { q: 'What if I want a chef for multiple nights?', a: '€85 per person, per night. A 3-night booking for 6 guests is €1,530 total, and we design a different menu for each night — mezze night, tagine night, royal couscous Friday.' },
  { q: 'Do you accept credit cards?', a: 'Yes — Stripe, Visa, Mastercard, Apple Pay. Or wire transfer in EUR or USD. Or local cash in MAD on the night, if that’s easier.' },
];

const faqLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: [
    { q: 'How much does a private chef cost in Marrakech?', a: 'From €85 per person at La Table Marrakech. The price covers menu planning, fresh souk ingredients, multi-course cooking, table service, mint-tea ceremony and full kitchen cleanup. There are no hidden fees, no minimum spend per booking other than 2 guests, and no service charges. A couple pays €170, a family of four €340, a group of eight €680.' },
    { q: "What's included in the price?", a: "Everything: menu planning over WhatsApp, the chef's morning visit to the medina souk, all ingredients and cookware, the cooking itself, plating and table service, the mint-tea ceremony, and complete kitchen cleanup before they leave. The €85 per person rate is all-inclusive." },
    { q: "What's NOT included?", a: "Drinks, premium add-ons like live cooking stations, chef tip (10% is standard but not required), and any cuts of luxury produce that exceed the standard food budget — fresh truffle, lobster, A5 wagyu — which we'll quote separately if you ask." },
    { q: 'How does this compare to eating at a Marrakech restaurant?', a: "€85 per person sits in the same range as Marrakech's top restaurants — La Mamounia, Le Jardin, Nomad, Dar Rhizlane — which are €60–€120 per person for a multi-course meal." },
    { q: 'How much is a private chef for a wedding or large group?', a: 'Wedding event packages start at €1,200 for 20 guests (a custom event tier separate from the per-person rate); corporate dinners start at €650 for 10 with full service.' },
  ].map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const tiers = [
  { name: 'Intimate Dinner', price: '€85', unit: 'per person', meta: '2–4 guests · one evening', features: ['Multi-course menu (5 courses)', 'Souk shopping that morning', 'Cooking, service, full cleanup', 'Mint tea ceremony to finish'], cta: { label: 'Book intimate', wa: 'Hi%20%E2%80%94%20I%27d%20like%20to%20book%20an%20intimate%20dinner.%20Date%3A%20%5B%5D%2C%20Guests%3A%20%5B%5D.' } },
  { name: 'Villa Gathering', price: '€85', unit: 'per person', meta: '5–12 guests · villa or riad', features: ['Multi-course menu, customised', 'Souk shopping that morning', 'Cooking, plating, table service', 'Hand-written menu cards', 'Full kitchen cleanup'], popular: true, cta: { label: 'Book villa', wa: 'Hi%20%E2%80%94%20I%27d%20like%20to%20book%20a%20villa%20dinner.%20Date%3A%20%5B%5D%2C%20Guests%3A%20%5B%5D%2C%20Villa%3A%20%5B%5D.' } },
  { name: 'Celebration & Event', price: '€60+', unit: 'per person', meta: '13–30+ · weddings, retreats', features: ['Custom menu design with the chef', 'Full brigade — chef + service staff', 'Souk shopping + premium produce', 'Setup, service, complete cleanup', 'Live cooking station (add-on)'], cta: { label: 'Plan celebration', wa: 'Hi%20%E2%80%94%20I%27d%20like%20to%20plan%20a%20celebration%20dinner.%20Date%3A%20%5B%5D%2C%20Guests%3A%20%5B%5D%2C%20Type%20of%20event%3A%20%5B%5D.' } },
];

const included = ['Menu planning', 'The souk run', 'All ingredients', 'All cookware', 'Cooking', 'Service', 'Cleanup'];
const notIncluded = ['Drinks', 'Premium produce', 'Live cooking stations at events', 'Chef tip', 'Transport (Atlas / Agafay)'];
---

<Layout
  title="Private Chef Cost in Marrakech (2026): From €85 per person | La Table"
  description="Transparent 2026 pricing for a private chef in Marrakech: €85 per person, all-inclusive. What you get for the price, what's not included, and how it compares to fine dining. Minimum 2 guests."
  twitterTitle="Private Chef Cost in Marrakech (2026)"
  twitterDescription="From €85 per person, all-inclusive. No hidden fees, no service charges. Minimum 2 guests."
  canonical="https://latablemarrakech.com/private-chef-cost-marrakech/"
  ogLocale="en_US"
  ogLocaleAlternates={["fr_FR"]}
  htmlLang="en"
  hreflang={[
    { hreflang: 'en', href: 'https://latablemarrakech.com/private-chef-cost-marrakech/' },
    { hreflang: 'fr', href: 'https://latablemarrakech.com/fr/chef-prive-prix-marrakech/' },
    { hreflang: 'x-default', href: 'https://latablemarrakech.com/private-chef-cost-marrakech/' },
  ]}
  jsonLd={[breadcrumbLd, articleLd, faqLd]}
>
  <Nav lang="en" />

  <main class="bg-ink">
    {/* Hero — centered, narrow, restrained */}
    <header class="pt-24 pb-16 sm:pt-32 sm:pb-20">
      <div class="container flex flex-col items-center gap-8 text-center">
        <nav class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.22em] text-sand-muted" aria-label="Breadcrumb">
          <a href="/" class="hover:text-gold-light">Home</a>
          <span aria-hidden="true" class="text-ember">◆</span>
          <span class="text-gold-light">Pricing</span>
        </nav>
        <span class="inline-flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.32em] text-gold-light">
          <span aria-hidden="true" class="inline-block size-1.5 rotate-45 bg-ember"></span>
          Pricing · 2026 · Updated April
        </span>
        <h1 class="max-w-[820px] font-display text-[clamp(2.75rem,7vw,5.5rem)] font-normal leading-[0.92] tracking-[0.02em] text-sand">
          How much does a private chef
          <em class="mt-3 block font-serif italic font-normal text-[0.45em] text-gold-light">cost in Marrakech?</em>
        </h1>
        <p class="max-w-[640px] text-[17px] leading-[1.7] text-sand">
          One number, all-inclusive. €85 per person covers a multi-course Moroccan dinner cooked at your villa or
          riad — souk shopping, cooking, service, mint tea, complete cleanup. Minimum 2 guests.
        </p>
      </div>
    </header>

    {/* Pricing tiers — Hyperagent-style: white-on-dark cards, big number,
        feature list, single ghost CTA per card. No ribbons, no border colors. */}
    <section class="pb-24">
      <div class="container">
        <div class="mx-auto grid max-w-[1100px] gap-px overflow-hidden rounded-md bg-gold/15 sm:grid-cols-3">
          {tiers.map((t) => (
            <article class={['relative flex flex-col gap-6 bg-ink-light p-8', t.popular ? 'ring-1 ring-ember/40' : ''].join(' ')}>
              {t.popular && (
                <span class="absolute -top-px left-0 right-0 bg-ember py-1 text-center font-mono text-[10px] uppercase tracking-[0.22em] text-white">Most popular</span>
              )}
              <div class={t.popular ? 'pt-4' : ''}>
                <h2 class="font-mono text-[11px] uppercase tracking-[0.22em] text-sand-muted">{t.name}</h2>
                <p class="mt-3 flex items-baseline gap-2 font-display tracking-[0.04em] text-sand">
                  <span class="text-[3.5rem] leading-none">{t.price}</span>
                  <span class="font-mono text-[11px] uppercase tracking-[0.22em] text-sand-muted">{t.unit}</span>
                </p>
                <p class="mt-3 font-mono text-[10px] uppercase tracking-[0.22em] text-gold-light">{t.meta}</p>
              </div>
              <ul class="flex flex-1 flex-col gap-2.5 text-[14px] leading-relaxed text-sand">
                {t.features.map((f) => (
                  <li class="flex items-start gap-2.5">
                    <span aria-hidden="true" class="mt-1.5 inline-block size-1.5 shrink-0 rotate-45 bg-ember"></span>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
              <a
                data-event="whatsapp_click" data-location="pricing"
                href={`https://wa.me/212721354757?text=${t.cta.wa}`}
                target="_blank" rel="noopener noreferrer"
                class={[
                  'mt-2 inline-flex items-center justify-center gap-2 rounded-full px-6 py-3 font-mono text-[11px] uppercase tracking-[0.22em] transition',
                  t.popular ? 'bg-ember text-white hover:bg-ember-light' : 'border border-gold/40 text-sand hover:border-gold-light hover:bg-gold/10',
                ].join(' ')}
              >
                {t.cta.label}
              </a>
            </article>
          ))}
        </div>
        <p class="mx-auto mt-6 max-w-[820px] text-center font-mono text-[11px] tracking-[0.04em] text-sand-muted">
          Drinks and any premium add-ons quoted separately. Minimum 2 guests — no charge for empty seats.
        </p>
      </div>
    </section>

    {/* Included / Not included — two-column quiet list, no card chrome */}
    <section class="border-t border-gold/15 py-24">
      <div class="container mx-auto grid max-w-[1000px] gap-16 md:grid-cols-2">
        <div>
          <h2 class="font-mono text-[11px] uppercase tracking-[0.32em] text-gold-light">What's included</h2>
          <ul class="mt-6 grid gap-3">
            {included.map((i) => (
              <li class="flex items-start gap-3 text-[16px] leading-[1.7] text-sand">
                <span aria-hidden="true" class="mt-2.5 inline-block size-1.5 shrink-0 rotate-45 bg-ember"></span>
                <span>{i}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="font-mono text-[11px] uppercase tracking-[0.32em] text-sand-muted">What's not included</h2>
          <ul class="mt-6 grid gap-3">
            {notIncluded.map((i) => (
              <li class="flex items-start gap-3 text-[16px] leading-[1.7] text-sand-muted">
                <span aria-hidden="true" class="mt-2.5 inline-block size-1.5 shrink-0 rotate-45 bg-sand-muted/40"></span>
                <span>{i}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    {/* Honest math — quote-style, no border-l flourish */}
    <section class="border-t border-gold/15 py-24">
      <div class="container mx-auto max-w-[760px] text-center">
        <p class="font-mono text-[11px] uppercase tracking-[0.32em] text-gold-light">The honest math</p>
        <p class="mt-6 font-serif text-[clamp(1.25rem,2.5vw,1.75rem)] italic leading-[1.55] text-sand">
          “For a group of 6 in a Palmeraie villa for 3 nights, one chef dinner is €510 — same range as one
          night at a top Marrakech riad restaurant for the same group, before drinks. Eat with us once or
          twice across the trip and cook for yourselves the rest.”
        </p>
        <p class="mt-6 font-mono text-[10px] uppercase tracking-[0.22em] text-sand-muted">
          What you're paying for is exclusivity, not discount.
        </p>
      </div>
    </section>

    {/* Compare line — single sentence, centered */}
    <section class="border-t border-gold/15 py-24">
      <div class="container mx-auto max-w-[760px]">
        <h2 class="text-center font-display text-[clamp(1.75rem,3.5vw,2.75rem)] tracking-[0.04em] text-sand">
          Same range as <em class="font-serif italic font-normal text-gold-light">fine dining</em>
        </h2>
        <p class="mx-auto mt-6 max-w-[640px] text-center text-[17px] leading-[1.7] text-sand">
          Marrakech's top restaurants — Mamounia, Le Jardin, Nomad, Dar Rhizlane — sit at €60–120 per person
          for a multi-course meal. €85 sits in the middle of that band. The difference: the room is yours,
          the menu was sketched around your group at the souk, and the table is whatever you make of it.
        </p>
        <p class="mt-6 text-center text-sand-muted">
          A cooking class typically runs $45–90 per person.
          <a href="/marrakech-cooking-class-vs-private-chef/" class="text-ember-light hover:text-gold-light underline-offset-4 hover:underline">Class vs chef — full comparison</a>.
        </p>
      </div>
    </section>

    {/* FAQ — clean accordion, no boxes */}
    <section class="border-t border-gold/15 py-24">
      <div class="container mx-auto max-w-[760px]">
        <h2 class="text-center font-display text-[clamp(1.75rem,3.5vw,2.75rem)] tracking-[0.04em] text-sand">FAQ</h2>
        <div class="mt-10 grid gap-0">
          {faqs.map((f) => (
            <details class="group border-b border-gold/15 py-5">
              <summary class="flex cursor-pointer items-center justify-between gap-4 font-serif text-[18px] text-sand list-none [&::-webkit-details-marker]:hidden">
                <span>{f.q}</span>
                <span aria-hidden="true" class="font-display text-2xl text-ember transition group-open:rotate-45">+</span>
              </summary>
              <p class="mt-3 leading-[1.75] text-sand-muted">
                {f.a}
                {f.linkHref && (
                  <>{' '}<a href={f.linkHref} class="text-ember-light hover:text-gold-light underline-offset-4 hover:underline">{f.linkText}</a></>
                )}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>

    {/* CTA band */}
    <section class="border-t border-gold/15 py-24">
      <div class="container mx-auto max-w-[700px] text-center">
        <span class="inline-flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.32em] text-gold-light">
          <span aria-hidden="true" class="inline-block size-1.5 rotate-45 bg-ember"></span>
          Confirmed in 24 hours
        </span>
        <h2 class="mt-6 font-display text-[clamp(2.25rem,4.5vw,3.5rem)] leading-[1] tracking-[0.04em] text-sand">
          Get a custom quote.
          <em class="mt-2 block font-serif italic font-normal text-[0.55em] text-gold-light">It really is one WhatsApp away.</em>
        </h2>
        <p class="mt-5 text-sand-muted">
          Tell us the date, the headcount, the dietaries. We reply with a draft menu and an exact price.
        </p>
        <a
          data-event="whatsapp_click" data-location="pricing"
          href="https://wa.me/212721354757?text=Hi%20%E2%80%94%20I%27d%20like%20a%20private%20chef%20quote"
          target="_blank" rel="noopener noreferrer"
          class="mt-8 inline-flex items-center gap-3 rounded-full bg-ember px-8 py-4 font-mono text-[12px] uppercase tracking-[0.22em] text-white transition hover:-translate-y-px hover:bg-ember-light"
        >
          WhatsApp the chef
          <span aria-hidden="true" class="inline-block size-2 rotate-45 bg-white"></span>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
