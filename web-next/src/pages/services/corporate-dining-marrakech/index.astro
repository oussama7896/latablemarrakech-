---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://latablemarrakech.com/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://latablemarrakech.com/services/' },
    { '@type': 'ListItem', position: 3, name: 'Corporate Dining Marrakech', item: 'https://latablemarrakech.com/services/corporate-dining-marrakech/' },
  ],
};

const serviceLd = {
  '@context': 'https://schema.org', '@type': 'Service',
  serviceType: 'Corporate Dinner Planning — Private Chef',
  name: 'Corporate Dining Marrakech',
  description: 'Private dinner planner in Marrakech for corporate retreats, incentive trips and client dinners. Multilingual team, multi-course Moroccan tasting menus, full service. From €650 for 10 guests.',
  provider: { '@type': 'Organization', name: 'La Table Marrakech', url: 'https://latablemarrakech.com/', telephone: '+212721354757', areaServed: 'Marrakech' },
  areaServed: [
    { '@type': 'City', name: 'Marrakech' },
    { '@type': 'Place', name: 'Palmeraie Marrakech' },
    { '@type': 'Place', name: 'Agafay Desert' },
  ],
  offers: { '@type': 'Offer', priceCurrency: 'EUR', price: '650', priceSpecification: { '@type': 'PriceSpecification', minPrice: '650', priceCurrency: 'EUR' }, availability: 'https://schema.org/InStock', url: 'https://latablemarrakech.com/services/corporate-dining-marrakech/#book' },
};

const faqLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: [
    { q: 'How much does corporate dining cost in Marrakech?', a: 'Corporate dinner bookings at La Table Marrakech start at €650 for 10 guests, including a 5-course Moroccan tasting menu, souk sourcing, full service and cleanup. We invoice in EUR or USD with VAT-compliant documentation; net-30 terms are available for established companies.' },
    { q: 'Can you handle a multilingual group?', a: 'Yes. Service in English, French and Arabic by default. Spanish, German and Italian briefs on request.' },
    { q: 'Do you provide an invoice for corporate clients?', a: 'Yes. We invoice in EUR or USD, with VAT-compliant documentation suitable for European, UK and US accounting. Net-30 terms are available for repeat or enterprise clients.' },
  ].map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const faqs = [
  { q: 'How much does corporate dining cost in Marrakech?', a: 'From €650 for 10 guests, scaling per guest. Includes menu design, souk sourcing, full service team and cleanup. No per-guest service charges, no minimum bar spend.' },
  { q: 'Do you provide an invoice?', a: 'Yes. EUR or USD, VAT-compliant, suitable for EU/UK/US bookkeeping. Net-30 available for repeat clients. Stripe, wire or company card all accepted.' },
  { q: "Can you handle a venue if we don't have one?", a: "Yes. We work with a vetted set of riads, villas and desert camps. Tell us the group size, the budget envelope, and the night, and we'll come back with two or three options that match." },
  { q: 'Are NDAs available?', a: "Yes — mutual or one-way, signed before the quote if you prefer. Discretion is the default; we don't post about clients." },
];

const packages = [
  { label: 'Boardroom Dinner', price: '€650', detail: 'Up to 10 guests · 5 courses\nRiad or villa\nChef + 1 service host', popular: false },
  { label: 'Offsite / Retreat', price: '€1,800', detail: 'Up to 25 guests · 6 courses\nOptional cooking class · team mezze night\nChef + 3 service staff', popular: true },
  { label: 'Incentive Group', price: '€3,200', detail: 'Up to 50 guests · full programme\nDesert dinner · live cooking station\nChef brigade + 6 service staff', popular: false },
];

const steps = [
  { n: '01', eyebrow: 'Reply < 24h', title: 'Fast turnaround', body: "Most quotes are sent within 24 hours. Last-minute (under 7 days) is regularly possible — flag it in your message and we'll reply same-day." },
  { n: '02', eyebrow: 'EUR / USD', title: 'Compliant invoicing', body: 'VAT-compliant invoice in EUR or USD, suitable for European, UK and US accounting. Net-30 terms for repeat or enterprise clients. Stripe, wire or company card.' },
  { n: '03', eyebrow: 'EN / FR / AR', title: 'Multilingual team', body: "Service in English, French and Arabic by default. Spanish, German and Italian briefs on request. Printed menus and dietary cards in your guest list's language." },
];
---

<Layout
  title="Corporate Dining Marrakech — Private Dinner Planner from €650 | La Table Marrakech"
  description="Corporate private dining in Marrakech — private chef for client dinners, retreats, and team events. Bespoke menus and full service from €85 per person."
  twitterTitle="Corporate Dining Marrakech — From €650 | La Table Marrakech"
  twitterDescription="Private dinner planner for offsites, retreats and client dinners in Marrakech."
  canonical="https://latablemarrakech.com/services/corporate-dining-marrakech/"
  htmlLang="en"
  hreflang={[
    { hreflang: 'en', href: 'https://latablemarrakech.com/services/corporate-dining-marrakech/' },
    { hreflang: 'x-default', href: 'https://latablemarrakech.com/services/corporate-dining-marrakech/' },
  ]}
  jsonLd={[breadcrumbLd, serviceLd, faqLd]}
>
  <Nav lang="en" />

  <main>
    <section class="bg-ink-light py-28 sm:py-32">
      <div class="container max-w-[920px]">
        <nav class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.22em] text-sand-muted" aria-label="Breadcrumb">
          <a href="/" class="hover:text-gold-light">Home</a>
          <span aria-hidden="true" class="text-ember">◆</span>
          <a href="/#services" class="hover:text-gold-light">Services</a>
          <span aria-hidden="true" class="text-ember">◆</span>
          <span class="text-gold-light">Corporate Dining</span>
        </nav>
        <span class="eyebrow mt-8 inline-flex items-center gap-3"><span class="inline-block size-1.5 rotate-45 bg-ember"></span>Corporate Dinner · Marrakech · From €650</span>
        <h1 class="mt-6 font-display text-[clamp(2.75rem,7vw,5.5rem)] leading-[0.92] tracking-[0.04em] text-sand">
          Offsites, retreats, client dinners.
          <em class="mt-3 block font-serif italic font-normal text-[0.55em] text-gold-light">Cooked for you.</em>
        </h1>
        <p class="mt-7 max-w-2xl text-lg leading-relaxed text-sand">
          A private dinner planner in Marrakech for executive retreats, incentive trips, board offsites and client
          dinners. Souk-fresh Moroccan tasting menus at riads, villas and desert camps. Invoiceable, multilingual,
          fully managed. From €650 for 10 guests.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-4">
          <a data-event="whatsapp_click" data-location="corporate" href="https://wa.me/212721354757?text=I%27d%20like%20a%20corporate%20dining%20quote" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 bg-ember px-9 py-5 font-mono text-[13px] uppercase tracking-[0.28em] text-white transition hover:-translate-y-px hover:bg-ember-light">Request a quote<span aria-hidden="true" class="inline-block size-2 rotate-45 bg-white"></span></a>
          <a href="#packages" class="inline-flex items-center gap-3 border border-gold px-9 py-5 font-mono text-[13px] uppercase tracking-[0.28em] text-sand transition hover:border-gold-light hover:bg-gold/10 hover:text-gold-light">See packages</a>
        </div>
      </div>
    </section>

    <section class="bg-ink py-28">
      <div class="container">
        <span class="eyebrow inline-flex items-center gap-3 text-ember-light"><span class="inline-block size-1.5 rotate-45 bg-ember"></span>Why we exist</span>
        <h2 class="mt-6 max-w-3xl font-display text-[clamp(2rem,4.5vw,3.5rem)] leading-[1.05] tracking-[0.04em] text-sand">
          Restaurants are loud.
          <em class="mt-2 block font-serif italic font-normal text-[0.55em] text-gold-light">Decisions need quiet.</em>
        </h2>
        <div class="my-10 flex justify-center" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 14 14" class="text-ember"><polygon points="7,0 14,7 7,14 0,7" fill="currentColor" opacity="0.3"/><polygon points="7,3 11,7 7,11 3,7" fill="currentColor"/></svg></div>
        <div class="grid gap-10 lg:grid-cols-2">
          <div class="space-y-5 text-[17px] leading-[1.75] text-sand">
            <p>The dinners that move a deal forward are not the dinners with a wine list as long as a passport. They are the ones where the room is yours, the chef is in the kitchen, and the table is small enough that every voice carries. That is what we cook.</p>
            <p>Founders bring their boards. PE firms bring their portfolio CEOs. Tech offsites bring their leadership team. The brief is always the same: we want this to feel like Marrakech — not like a hotel ballroom.</p>
          </div>
          <div class="space-y-5 text-[17px] leading-[1.75] text-sand">
            <p>We meet your EA on email or WhatsApp, we send a quote in 24 hours, we invoice in EUR or USD, and we handle the venue if you don't have one (riad, villa, palmeraie, or an Agafay desert camp at sunset). Your team shows up. We do the rest.</p>
            <p>Multilingual service. NDAs available. Discreet by default. We have cooked for groups whose names you'd recognise; we don't post about it.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="packages" class="bg-ink-light py-28">
      <div class="container">
        <span class="eyebrow inline-flex items-center gap-3 text-ember-light"><span class="inline-block size-1.5 rotate-45 bg-ember"></span>Packages</span>
        <h2 class="mt-6 max-w-3xl font-display text-[clamp(2rem,4.5vw,3.5rem)] leading-[1.05] tracking-[0.04em] text-sand">
          Three formats
          <em class="mt-2 block font-serif italic font-normal text-[0.55em] text-gold-light">that work</em>
        </h2>
        <div class="my-10 flex justify-center" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 14 14" class="text-ember"><polygon points="7,0 14,7 7,14 0,7" fill="currentColor" opacity="0.3"/><polygon points="7,3 11,7 7,11 3,7" fill="currentColor"/></svg></div>
        <div class="mt-6 grid gap-6 lg:grid-cols-3">
          {packages.map((p) => (
            <article class={['relative flex flex-col gap-5 border bg-ink p-8', p.popular ? 'border-ember/60 ring-1 ring-ember/30' : 'border-gold/20'].join(' ')}>
              {p.popular && <span class="absolute -top-3 right-5 bg-ember px-3 py-1 font-mono text-[10px] uppercase tracking-[0.18em] text-white">Most popular</span>}
              <span class="font-mono text-[11px] uppercase tracking-[0.22em] text-ember">◆ {p.label}</span>
              <span class="font-display text-[3rem] leading-none tracking-[0.04em] text-gold-light">{p.price}</span>
              <p class="whitespace-pre-line text-[15px] leading-relaxed text-sand-muted">{p.detail}</p>
            </article>
          ))}
        </div>
        <p class="mt-8 max-w-3xl text-sm leading-relaxed text-sand-muted"><strong class="text-sand">Included at every tier:</strong> menu design call, souk sourcing, full cookware and charcoal, plating and service team, mint-tea ceremony, complete cleanup, EU-format invoice. <strong class="text-sand">Optional:</strong> beverage packages, cooking class workshop, venue scouting, transport coordination.</p>
        <div class="mt-10">
          <a data-event="whatsapp_click" data-location="corporate" href="https://wa.me/212721354757?text=I%27d%20like%20a%20corporate%20dining%20quote" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 bg-ember px-9 py-5 font-mono text-[13px] uppercase tracking-[0.28em] text-white transition hover:-translate-y-px hover:bg-ember-light">Request a quote<span aria-hidden="true" class="inline-block size-2 rotate-45 bg-white"></span></a>
        </div>
      </div>
    </section>

    <section class="bg-ink py-28">
      <div class="container">
        <span class="eyebrow inline-flex items-center gap-3 text-ember-light"><span class="inline-block size-1.5 rotate-45 bg-ember"></span>For EAs &amp; planners</span>
        <h2 class="mt-6 max-w-3xl font-display text-[clamp(2rem,4.5vw,3.5rem)] leading-[1.05] tracking-[0.04em] text-sand">
          Built around
          <em class="mt-2 block font-serif italic font-normal text-[0.55em] text-gold-light">your timeline</em>
        </h2>
        <div class="my-10 flex justify-center" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 14 14" class="text-ember"><polygon points="7,0 14,7 7,14 0,7" fill="currentColor" opacity="0.3"/><polygon points="7,3 11,7 7,11 3,7" fill="currentColor"/></svg></div>
        <div class="grid gap-6 md:grid-cols-3">
          {steps.map((s) => (
            <article class="relative flex flex-col gap-4 border-l-2 border-ember/60 bg-ink-light p-7 pl-9">
              <span class="absolute -left-px top-7 -translate-x-1/2 bg-ink-light px-2 font-display text-3xl tracking-[0.05em] text-ember">{s.n}</span>
              <span class="font-mono text-[11px] uppercase tracking-[0.22em] text-ember-light">{s.eyebrow}</span>
              <h3 class="font-serif text-[20px] italic leading-snug text-sand">{s.title}</h3>
              <p class="text-sm leading-relaxed text-sand-muted">{s.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-ink-light py-28">
      <div class="container max-w-[760px]">
        <span class="eyebrow inline-flex items-center gap-3 text-ember-light"><span class="inline-block size-1.5 rotate-45 bg-ember"></span>FAQ</span>
        <h2 class="mt-6 font-display text-[clamp(2rem,4.5vw,3.5rem)] leading-[1.05] tracking-[0.04em] text-sand">
          Asked by every
          <em class="mt-2 block font-serif italic font-normal text-[0.55em] text-gold-light">EA</em>
        </h2>
        <div class="my-10 flex justify-center" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 14 14" class="text-ember"><polygon points="7,0 14,7 7,14 0,7" fill="currentColor" opacity="0.3"/><polygon points="7,3 11,7 7,11 3,7" fill="currentColor"/></svg></div>
        <div class="grid gap-0">
          {faqs.map((f) => (
            <details class="group border-b border-gold/20 py-5">
              <summary class="flex cursor-pointer items-center justify-between gap-4 font-serif text-[18px] text-sand list-none [&::-webkit-details-marker]:hidden">
                <span>{f.q}</span>
                <span aria-hidden="true" class="font-display text-2xl text-ember transition group-open:rotate-45">+</span>
              </summary>
              <p class="mt-3 leading-[1.75] text-sand-muted">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="border-t border-gold/15 bg-ink py-24">
      <div class="container max-w-[700px] text-center">
        <span class="eyebrow inline-flex items-center gap-3"><span class="inline-block size-1.5 rotate-45 bg-ember"></span>Tell us the brief</span>
        <h2 class="mt-6 font-display text-[clamp(2.25rem,4.5vw,3.5rem)] leading-[1] tracking-[0.04em] text-sand">
          Quote in
          <em class="mt-2 block font-serif italic font-normal text-[0.55em] text-gold-light">24 hours.</em>
        </h2>
        <p class="mt-5 text-sand-muted">WhatsApp the chef directly — or email <a href="mailto:hello@latablemarrakech.com" class="text-ember-light hover:text-gold-light hover:underline underline-offset-4">hello@latablemarrakech.com</a>.</p>
        <a data-event="whatsapp_click" data-location="corporate" href="https://wa.me/212721354757?text=I%27d%20like%20a%20corporate%20dining%20quote" target="_blank" rel="noopener noreferrer" class="mt-8 inline-flex items-center gap-3 bg-ember px-8 py-4 font-mono text-[12px] uppercase tracking-[0.22em] text-white transition hover:-translate-y-px hover:bg-ember-light">WhatsApp the chef<span aria-hidden="true" class="inline-block size-2 rotate-45 bg-white"></span></a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
